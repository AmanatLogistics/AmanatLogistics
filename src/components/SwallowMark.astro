---
/** Amanat swallow — inline so it inherits `currentColor` (burgundy on light, white on dark). */
interface Props {
  class?: string;
}
const { class: klass = '' } = Astro.props;
---

<svg
  class={klass}
  viewBox="0 0 500 340"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Amanat Logistics"
>
  <path
    d="M24 188 Q50 156 104 150 Q294 50 482 38 Q300 108 176 184 Q268 214 372 302 Q250 232 150 202 Q74 206 24 188 Z"
  ></path>
</svg>

---
/**
 * The bird from the Amanat logo, cut from the logo file itself rather than
 * redrawn, so it is the real mark. Used as a CSS mask, which lets it take
 * whatever colour it is given (`text-plum`, `text-white/10`…) like an icon.
 */
interface Props {
  class?: string;
}
const { class: klass = '' } = Astro.props;
---

<span
  class={`block ${klass}`}
  aria-hidden="true"
  style="aspect-ratio:400/253;background:currentColor;-webkit-mask:url(/images/brand-bird.png) center/contain no-repeat;mask:url(/images/brand-bird.png) center/contain no-repeat;"
></span>

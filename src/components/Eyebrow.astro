---
import BrandBird from './BrandBird.astro';

interface Props {
  text: string;
  /** color scheme: on light or on dark backgrounds */
  tone?: 'light' | 'dark';
  class?: string;
}
const { text, tone = 'light', class: klass = '' } = Astro.props;
const color = tone === 'dark' ? 'text-gold-light' : 'text-label';
// The logo's bird marks every section label, in place of the usual rule.
const bird = tone === 'dark' ? 'text-gold-light' : 'text-plum';
---

<div class={`flex items-center gap-2.5 ${klass}`}>
  <BrandBird class={`w-[22px] ${bird}`} />
  <span class={`eyebrow ${color}`}>{text}</span>
</div>

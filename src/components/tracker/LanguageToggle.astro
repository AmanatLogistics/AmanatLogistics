---
/**
 * English ⇄ Pashto switch for the tracking page.
 *
 * A plain link, not a script: it re-requests the same URL with ?lang= set, so
 * it works with JavaScript disabled and the result is a shareable URL. Any
 * tracking code already in the URL is carried across, so switching language
 * never loses the customer's search results.
 */
import { LANG_LABEL, otherLang, type Lang } from '../../lib/tracker/i18n';

interface Props {
  lang: Lang;
  /** Current page URL, used to preserve ?code= across the switch. */
  url: URL;
}
const { lang, url } = Astro.props;

const next = otherLang(lang);
const target = new URL(url);
target.searchParams.set('lang', next);
const href = `${target.pathname}${target.search}`;
---

<a
  href={href}
  hreflang={next}
  rel="nofollow"
  dir="ltr"
  class="inline-flex items-center gap-2 rounded-lg border border-line bg-cream px-3.5 py-2 text-[13.5px] font-semibold text-plum transition-colors hover:border-gold hover:bg-sand"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"></circle>
    <path d="M3 12h18M12 3c2.5 2.7 2.5 15 0 18M12 3c-2.5 2.7-2.5 15 0 18" stroke="currentColor" stroke-width="1.7"></path>
  </svg>
  {LANG_LABEL[next]}
</a>

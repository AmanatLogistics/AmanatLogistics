---
/**
 * Graceful image frame.
 * - If the real image exists at `src`, it fills the frame.
 * - If it's missing (assets not added yet), the labeled dashed placeholder
 *   from the design shows instead (the <img> removes itself on error).
 * Swap in real photos by dropping files into /public/images/… — no code change.
 */
import manifest from '../lib/image-manifest.json';

interface Asset {
  w: number;
  h: number;
  webp?: string;
  /** A narrow variant, for pictures only ever shown small. */
  small?: string;
  smallW?: number;
}

interface Props {
  src?: string;
  alt?: string;
  label?: string;
  /** color tone of the placeholder pattern */
  tone?: 'cream' | 'plum' | 'olive' | 'dark';
  /** extra classes for sizing (height, rounding, etc.) */
  class?: string;
  loading?: 'lazy' | 'eager';
  /**
   * How wide this picture will actually be, so the browser can pick the
   * narrow variant on a phone instead of downloading the full-size file.
   * Only worth giving where the image is shown small.
   */
  sizes?: string;
}

const { src, alt = '', label = 'IMAGE', tone = 'cream', class: klass = '', loading = 'lazy', sizes } = Astro.props;

/**
 * What scripts/optimise-images.mjs found: a WebP sibling and the real pixel
 * size of every picture shipped in the repo. A photo uploaded through /admin is
 * not in here, so it simply renders as a plain <img>, exactly as before.
 *
 * The size matters as much as the WebP: without width/height the browser cannot
 * reserve the space, and the gallery visibly jumped as its pictures arrived.
 */
const asset = src ? (manifest as Record<string, Asset | undefined>)[src] : undefined;

/**
 * Offer both widths when there is a narrow variant and the page has said how
 * wide the picture will be. Without a `sizes` hint the browser assumes full
 * viewport width and would pick the large file anyway, so there is no point
 * emitting a srcset then.
 */
const srcset =
  asset?.webp && asset.small && sizes
    ? `${asset.small} ${asset.smallW}w, ${asset.webp} ${asset.w}w`
    : asset?.webp;

const tones: Record<string, { pattern: string; text: string; border: string }> = {
  cream: {
    pattern: 'repeating-linear-gradient(45deg,#F6EFF2,#F6EFF2 11px,#EFE5E9 11px,#EFE5E9 22px)',
    text: '#6C5F65',
    border: '#B8A5AD',
  },
  plum: {
    pattern: 'repeating-linear-gradient(45deg,#4A1A2C,#4A1A2C 12px,#421727 12px,#421727 24px)',
    text: '#C2A6B0',
    border: '#7A4458',
  },
  olive: {
    pattern: 'repeating-linear-gradient(45deg,#2C5148,#2C5148 12px,#27493F 12px,#27493F 24px)',
    text: '#C2A6B0',
    border: '#5E8A7C',
  },
  dark: {
    pattern: 'repeating-linear-gradient(45deg,#33202A,#33202A 14px,#2B1922 14px,#2B1922 28px)',
    text: '#8E7C84',
    border: '#5F4A54',
  },
};

const t = tones[tone];
// When used as an absolute background (hero/header), don't also apply `relative`
// — the two conflict and break the layout. The frame is still a positioning
// context for its inner layers either way.
const isAbsolute = klass.includes('absolute');
---

<div class={`img-frame ${isAbsolute ? '' : 'relative'} overflow-hidden ${src ? '' : 'img-done'} ${klass}`}>
  {/* Placeholder layer — always present, so a missing/failed image never leaves
      an empty box. A real image renders on top and covers it once loaded. */}
  <div
    class="absolute inset-0 flex items-center justify-center px-4 text-center"
    style={`background:${t.pattern};border:1.5px dashed ${t.border};`}
  >
    {
      !src && (
        <span class="font-mono leading-relaxed" style={`font-size:11px;color:${t.text};`} set:html={label} />
      )
    }
  </div>
  {
    src && (
      /* <picture> rather than a bare <img>: browsers that take WebP get the
         smaller file, everything else falls back to the original untouched. */
      <picture>
        {srcset && <source srcset={srcset} sizes={sizes} type="image/webp" />}
        <img
          src={src}
          alt={alt}
          width={asset?.w}
          height={asset?.h}
          loading={loading}
          decoding="async"
          fetchpriority={loading === 'eager' ? 'high' : 'auto'}
          class="relative block h-full w-full object-cover"
          onload="this.classList.add('img-loaded');this.closest('.img-frame').classList.add('img-done')"
          onerror="this.closest('.img-frame').classList.add('img-done');this.remove()"
        />
      </picture>
    )
  }
</div>

<script>
  // Images that were already cached can fire `load` before the inline handler
  // attaches after a view transition — sweep and mark any completed images.
  function sweepLoadedImages() {
    document.querySelectorAll<HTMLImageElement>('.img-frame img').forEach((img) => {
      if (img.complete && img.naturalWidth > 0) {
        img.classList.add('img-loaded');
        img.closest('.img-frame')?.classList.add('img-done');
      } else if (img.complete) {
        img.closest('.img-frame')?.classList.add('img-done');
        img.remove();
      }
    });
  }
  document.addEventListener('astro:page-load', sweepLoadedImages);
</script>

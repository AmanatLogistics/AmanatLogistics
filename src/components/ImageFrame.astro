---
/**
 * Graceful image frame.
 * - If the real image exists at `src`, it fills the frame.
 * - If it's missing (assets not added yet), the labeled dashed placeholder
 *   from the design shows instead (the <img> removes itself on error).
 * Swap in real photos by dropping files into /public/images/… — no code change.
 */
interface Props {
  src?: string;
  alt?: string;
  label?: string;
  /** color tone of the placeholder pattern */
  tone?: 'cream' | 'plum' | 'olive' | 'dark';
  /** extra classes for sizing (height, rounding, etc.) */
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', label = 'IMAGE', tone = 'cream', class: klass = '', loading = 'lazy' } = Astro.props;

const tones: Record<string, { pattern: string; text: string; border: string }> = {
  cream: {
    pattern: 'repeating-linear-gradient(45deg,#EDE4D2,#EDE4D2 11px,#E6DBC4 11px,#E6DBC4 22px)',
    text: '#8C6D3F',
    border: '#B08A48',
  },
  plum: {
    pattern: 'repeating-linear-gradient(45deg,#4A2C3F,#4A2C3F 12px,#43273A 12px,#43273A 24px)',
    text: '#C9ADBF',
    border: '#7A5A6E',
  },
  olive: {
    pattern: 'repeating-linear-gradient(45deg,#4E5B44,#4E5B44 12px,#47543D 12px,#47543D 24px)',
    text: '#C6CBB8',
    border: '#7E8A72',
  },
  dark: {
    pattern: 'repeating-linear-gradient(45deg,#34302A,#34302A 14px,#2F2B25 14px,#2F2B25 28px)',
    text: '#A08F76',
    border: '#6E6252',
  },
};

const t = tones[tone];
// When used as an absolute background (hero/header), don't also apply `relative`
// — the two conflict and break the layout. The frame is still a positioning
// context for its inner layers either way.
const isAbsolute = klass.includes('absolute');
---

<div class={`img-frame ${isAbsolute ? '' : 'relative'} overflow-hidden ${src ? '' : 'img-done'} ${klass}`}>
  {/* Placeholder layer — always present, so a missing/failed image never leaves
      an empty box. A real image renders on top and covers it once loaded. */}
  <div
    class="absolute inset-0 flex items-center justify-center px-4 text-center"
    style={`background:${t.pattern};border:1.5px dashed ${t.border};`}
  >
    {
      !src && (
        <span class="font-mono leading-relaxed" style={`font-size:11px;color:${t.text};`} set:html={label} />
      )
    }
  </div>
  {
    src && (
      <img
        src={src}
        alt={alt}
        loading={loading}
        decoding="async"
        fetchpriority={loading === 'eager' ? 'high' : 'auto'}
        class="relative block h-full w-full object-cover"
        onload="this.classList.add('img-loaded');this.closest('.img-frame').classList.add('img-done')"
        onerror="this.closest('.img-frame').classList.add('img-done');this.remove()"
      />
    )
  }
</div>

<script>
  // Images that were already cached can fire `load` before the inline handler
  // attaches after a view transition — sweep and mark any completed images.
  function sweepLoadedImages() {
    document.querySelectorAll<HTMLImageElement>('.img-frame img').forEach((img) => {
      if (img.complete && img.naturalWidth > 0) {
        img.classList.add('img-loaded');
        img.closest('.img-frame')?.classList.add('img-done');
      } else if (img.complete) {
        img.closest('.img-frame')?.classList.add('img-done');
        img.remove();
      }
    });
  }
  document.addEventListener('astro:page-load', sweepLoadedImages);
</script>

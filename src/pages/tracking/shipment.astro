---
/**
 * Public shipment tracking — the Astro replacement for the original index.php.
 *
 * Reached at /tracking/shipment. /tracking itself now forwards to the
 * sheet-backed order lookup at /tracking/orders; this page is unchanged and
 * still serves the Postgres tracker, so switching back is a one-line change to
 * tracking/index.astro.
 *
 * Customers enter a tracking or invoice number; the form submits with GET so
 * results are shareable and bookmarkable, exactly as the PHP page worked.
 *
 * Available in English and Pashto. Fixed labels come from a written translation
 * (lib/tracker/i18n.ts); shipment text an admin typed that isn't one of the
 * standard stages falls back to Azure Translator (lib/tracker/translate.ts).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ShipmentDetails from '../../components/tracker/ShipmentDetails.astro';
import TrackingTimeline from '../../components/tracker/TrackingTimeline.astro';
import LanguageToggle from '../../components/tracker/LanguageToggle.astro';
import { isConfigured } from '../../lib/tracker/db';
import { findByCode, type Shipment, type ShipmentStep } from '../../lib/tracker/shipments';
import { htmlLang, isRtl, langCookie, resolveLang, t } from '../../lib/tracker/i18n';
import { translateMany } from '../../lib/tracker/translate';

export const prerender = false;

const lang = resolveLang(Astro.url, Astro.request);
const rtl = isRtl(lang);
// Remember the choice for the customer's next visit.
Astro.response.headers.append('Set-Cookie', langCookie(lang));
// Same URL serves two languages, so caches must vary on the cookie.
Astro.response.headers.set('Vary', 'Cookie');

const code = (Astro.url.searchParams.get('code') ?? '').trim();
const searched = code !== '';

let shipment: Shipment | null = null;
let steps: ShipmentStep[] = [];
let shippingMethod = '';
let lookupFailed = false;

if (searched && isConfigured()) {
  try {
    const found = await findByCode(code);
    if (found) {
      shipment = found.shipment;
      steps = found.steps;
      shippingMethod = shipment.shipping_method;

      if (lang !== 'en') {
        // One batched pass over everything customer-visible: every stage title,
        // every description, and the shipping method.
        const source = [
          ...steps.map((s) => s.step_title),
          ...steps.map((s) => s.step_description),
          shippingMethod,
        ];
        const out = await translateMany(source, lang);
        const n = steps.length;
        steps = steps.map((s, i) => ({
          ...s,
          step_title: out[i],
          step_description: out[n + i],
        }));
        shippingMethod = out[2 * n];
      }
    }
  } catch (e) {
    console.error('Tracking lookup failed:', e);
    lookupFailed = true;
  }
}

// Keeps the chosen language when the customer submits a new search.
const formLang = lang;
---

<BaseLayout
  title={lang === 'en' ? 'Track Shipment' : 'محموله تعقیب کړئ'}
  description="Track an Amanat Logistics shipment by tracking number or invoice number and follow its progress from origin to delivery."
  active="/tracking"
>
  {
    rtl && (
      <Fragment slot="head">
        {/* Fraunces and Archivo have no Arabic-script glyphs — load a Naskh face
            only when the page is actually showing Pashto. */}
        <link
          href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap"
          rel="stylesheet"
        />
      </Fragment>
    )
  }

  <!-- ============ PAGE HEADER ============ -->
  <section class="bg-plum" lang={htmlLang[lang]} dir={rtl ? 'rtl' : 'ltr'}>
    <div class="mx-auto flex max-w-[1240px] flex-col items-start gap-5 px-5 py-16 md:px-10 md:pb-[76px] md:pt-[84px]">
      <Eyebrow text={t(lang, 'eyebrow')} tone="dark" />
      <h1 class="m-0 font-serif text-[38px] font-bold leading-[1.12] text-[#F8F3E9] md:text-[52px]">
        {t(lang, 'pageTitle')}
      </h1>
      <p class="m-0 max-w-[62ch] text-[17px] leading-relaxed text-[#D9C8BE] md:text-[18px]">
        {t(lang, 'pageSubtitle')}
      </p>
    </div>
  </section>

  <!-- ============ TRACKING CARD ============ -->
  <section class="bg-cream" lang={htmlLang[lang]} dir={rtl ? 'rtl' : 'ltr'}>
    <div class="mx-auto max-w-[1240px] px-5 py-16 md:px-10 md:py-20">
      <div class="rounded-2xl border border-line bg-paper p-6 shadow-[0_10px_30px_rgba(42,26,18,0.06)] md:p-10">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
          <h2 class="m-0 flex items-center gap-2.5 font-serif text-[22px] font-bold text-plum md:text-[26px]">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="flex-none" aria-hidden="true">
              <path
                d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11Z"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"></path>
              <circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.7"></circle>
            </svg>
            {t(lang, 'cardTitle')}
          </h2>
          <LanguageToggle lang={lang} url={Astro.url} />
        </div>

        <!-- Search -->
        <form method="get" action="/tracking/shipment" class="flex flex-col gap-3 sm:flex-row">
          <input type="hidden" name="lang" value={formLang} />
          <label for="code" class="sr-only">{t(lang, 'searchLabel')}</label>
          <input
            id="code"
            name="code"
            type="text"
            required
            value={code}
            placeholder={t(lang, 'searchPlaceholder')}
            class="amn-field flex-1 rounded-lg border border-line bg-cream px-4 py-3.5 text-[15px] text-ink placeholder:text-muted/70"
          />
          <button
            type="submit"
            class="flex items-center justify-center gap-2 rounded-lg bg-accent px-7 py-3.5 text-[15px] font-semibold text-paper transition-colors hover:bg-plum-hover"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" class="flex-none" aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2"></circle>
              <path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
            </svg>
            {t(lang, 'trackNow')}
          </button>
        </form>

        <!-- Results -->
        {
          !isConfigured() && searched && (
            <p class="mt-7 rounded-lg border border-[#E8C9A8] bg-[#FBF0E2] px-4 py-3.5 text-[14.5px] text-[#8C5A2B]">
              {t(lang, 'unavailable')}
            </p>
          )
        }

        {
          lookupFailed && (
            <p class="mt-7 rounded-lg border border-[#E8C9A8] bg-[#FBF0E2] px-4 py-3.5 text-[14.5px] text-[#8C5A2B]">
              {t(lang, 'lookupFailed')}
            </p>
          )
        }

        {
          searched && !shipment && isConfigured() && !lookupFailed && (
            <div class="mt-7 flex items-start gap-3 rounded-lg border border-[#EBC3BD] bg-[#FBEEEC] px-4 py-3.5 text-[14.5px] text-[#9A3226]">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" class="mt-px flex-none" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
                <path d="M12 7.5v5.5M12 16.2v.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span>
                {t(lang, 'notFound')} "<bdi>{code}</bdi>". {t(lang, 'notFoundHint')}
              </span>
            </div>
          )
        }

        {
          shipment && (
            <div class="mt-8 grid grid-cols-1 items-start gap-6 lg:grid-cols-[340px_1fr]">
              <ShipmentDetails shipment={shipment} lang={lang} shippingMethod={shippingMethod} />
              <TrackingTimeline steps={steps} currentStep={shipment.current_step} lang={lang} />
            </div>
          )
        }

        {
          !searched && (
            <div class="mt-8 flex flex-col items-center gap-3 rounded-xl border border-dashed border-line bg-cream px-6 py-14 text-center">
              <svg width="46" height="46" viewBox="0 0 24 24" fill="none" class="text-label" aria-hidden="true">
                <path
                  d="M3 8.5 12 4l9 4.5v7L12 20l-9-4.5v-7Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
                <path d="m3 8.5 9 4.5 9-4.5M12 13v7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              </svg>
              <p class="m-0 max-w-[46ch] text-[15px] leading-relaxed text-muted">{t(lang, 'emptyState')}</p>
            </div>
          )
        }
      </div>

      <p class="mt-6 text-center text-[14px] text-muted">
        {t(lang, 'cantFind')}{' '}
        <a
          href={`/contact#form`}
          class="font-semibold text-accent-deep underline underline-offset-2 hover:text-plum"
        >
          {t(lang, 'contactTeam')}
        </a>{' '}
        {t(lang, 'andWeLook')}
      </p>
    </div>
  </section>
</BaseLayout>

{/* Arabic-script type for the Pashto view. Scoped to the tracking sections so
    the site's Fraunces/Archivo identity is untouched everywhere else. */}
{
  rtl && (
    <style is:global>
      [dir='rtl'],
      [dir='rtl'] .font-serif {
        font-family: 'Noto Naskh Arabic', 'Segoe UI', Tahoma, sans-serif;
      }
      /* Naskh sits lower than Latin faces and needs a little more room. */
      [dir='rtl'] h1,
      [dir='rtl'] h2,
      [dir='rtl'] h3 {
        line-height: 1.5;
      }
    </style>
  )
}

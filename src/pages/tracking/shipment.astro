---
/**
 * /tracking/shipment was the tracker's address for a while, when /tracking
 * itself pointed at the sheet lookup. The tracker is back at /tracking; this
 * keeps any link that was shared in the meantime working, query and all.
 */
export const prerender = false;

const target = new URL(Astro.url);
target.pathname = '/tracking';
return Astro.redirect(`${target.pathname}${target.search}`, 307);
---

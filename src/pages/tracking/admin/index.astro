---
/**
 * Tracker admin — login screen + shipment dashboard.
 * Replaces src/Tracker/admin/login.php and admin/dashboard.php.
 *
 * This panel is completely separate from the website content admin at /admin:
 * different password (TRACKER_ADMIN_PASSWORD), different cookie.
 *
 * The whole shipment list is sent to the browser and filtered there, so picking
 * a status is instant rather than a page load. It still works with JavaScript
 * off: `?status=` and `?q=` arrive as CSS rules that hide the rows that do not
 * match, and the "Received" button falls back to a normal form POST.
 */
import TrackerAdminLayout from '../../../layouts/TrackerAdminLayout.astro';
import TrackerAdminLogin from '../../../layouts/TrackerAdminLogin.astro';
import { SITE } from '../../../consts';
import { isTrackerAdmin, trackerPassword } from '../../../lib/tracker/auth';
import { isConfigured, DB_NOT_CONFIGURED } from '../../../lib/tracker/db';
import {
  asStatus,
  countBy,
  dueHint,
  formatDate,
  isOverdue,
  listShipments,
  searchText,
  statusOf,
  STATUS_LABEL,
  STEP_COUNT,
  type ShipmentSummary,
  type Status,
} from '../../../lib/tracker/shipments';

export const prerender = false;

const authed = await isTrackerAdmin(Astro.request);
const params = Astro.url.searchParams;

/* ---------- logged out: show the login form ---------- */
const loginErrors: Record<string, string> = {
  '1': 'Wrong password.',
  origin: 'That request looked unsafe, so it was blocked. Please try again.',
  unconfigured: 'The tracker admin password is not set. Add TRACKER_ADMIN_PASSWORD in your Vercel environment variables.',
};
const loginError = loginErrors[params.get('error') ?? ''] ?? '';

/* ---------- logged in: load everything, filter in the browser ---------- */
// Anything unrecognised in ?status= falls back to "all" rather than erroring.
const status = asStatus(params.get('status') ?? '');
const search = (params.get('q') ?? '').trim();

let shipments: ShipmentSummary[] = [];
let loadError = '';

if (authed) {
  if (!isConfigured()) {
    loadError = DB_NOT_CONFIGURED;
  } else {
    try {
      shipments = await listShipments();
    } catch (e) {
      console.error('Tracker dashboard failed to load:', e);
      loadError = 'Could not read the shipments table. Check that the database is reachable.';
    }
  }
}

const counts = countBy(shipments);

const notice = params.has('received')
  ? 'Shipment marked as received.'
  : params.has('saved')
    ? 'Shipment saved successfully.'
    : params.has('deleted')
      ? 'Shipment deleted.'
      : '';
const actionError = params.get('error') === 'receive'
  ? 'Could not mark that shipment as received. Please try again.'
  : '';

/**
 * No-JavaScript search. The term is embedded in a CSS attribute selector, so it
 * is reduced to letters, digits and a few separators first: with `<` and `>`
 * impossible, the value cannot break out of the <style> element, and with `"`
 * and `\` impossible it cannot break out of the selector either.
 */
const cssSafeSearch = search.toLowerCase().replace(/[^a-z0-9 @._-]/g, '').slice(0, 60);

/** Tile links keep the current search so the two filters compose without JS. */
const filterHref = (next: Status | '') => {
  const url = new URLSearchParams();
  if (search) url.set('q', search);
  if (next) url.set('status', next);
  const qs = url.toString();
  return qs ? `/tracking/admin?${qs}` : '/tracking/admin';
};

const tiles: { key: Status | ''; label: string; value: number; tone: string; note: string }[] = [
  { key: '', label: 'All shipments', value: counts.total, tone: 'all', note: 'Everything on file' },
  { key: 'pending', label: 'Pending', value: counts.pending, tone: 'idle', note: 'Booked, not moving yet' },
  { key: 'transit', label: 'In Transit', value: counts.transit, tone: 'transit', note: 'On the way' },
  { key: 'received', label: 'Received', value: counts.received, tone: 'done', note: 'Delivered to customer' },
  { key: 'overdue', label: 'Overdue', value: counts.overdue, tone: 'late', note: 'Past ETA, not received' },
];

const badgeTone = (bucket: 'pending' | 'transit' | 'received') =>
  bucket === 'received' ? 'done' : bucket === 'transit' ? 'transit' : 'idle';
---

{
  !authed ? (
    <TrackerAdminLogin>
      <div class="login-box">
        <h1>Shipment Tracker</h1>
        <p class="lede">Sign in to add and update shipments.</p>

        {loginError && <div class="alert alert-err">{loginError}</div>}
        {!trackerPassword() && !loginError && (
          <div class="alert alert-err">
            No tracker password is set yet. Add <code>TRACKER_ADMIN_PASSWORD</code> to your
            environment variables.
          </div>
        )}

        <form method="post" action="/api/tracker/login">
          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required autofocus />
          </div>
          <button class="btn btn-primary" type="submit">Log in</button>
        </form>

        <a class="back" href="/">← Back to {SITE.name}</a>
      </div>
    </TrackerAdminLogin>
  ) : (
    <TrackerAdminLayout title="Shipments">
      {cssSafeSearch && (
        <style
          id="nojs-search"
          set:html={`[data-row]:not([data-search*="${cssSafeSearch}"]){display:none}`}
        />
      )}

      <div class="dash" data-filter={status} data-load-error={loadError ? '1' : '0'}>
        <div class="page-head">
          <div>
            <h1>Shipments</h1>
            <p class="page-sub" data-summary>
              An overview of every consignment and where it has reached.
            </p>
          </div>
          <a href="/tracking/admin/new" class="btn btn-primary">+ Add new shipment</a>
        </div>

        <div class="alert alert-ok" data-notice hidden={!notice}>
          {notice}
        </div>
        {actionError && <div class="alert alert-err">{actionError}</div>}
        {loadError && <div class="alert alert-err">{loadError}</div>}

        {/* Tiles are the status filter. Real links, so they work without JS and
            can be bookmarked; the script turns them into instant filters. */}
        <div class="stat-grid">
          {/* The site prefetches links by default; the script intercepts these,
              so prefetching five copies of this page would be pure waste. */}
          {tiles.map((tile) => (
            <a
              class={`stat stat-${tile.tone}${tile.key === status ? ' is-active' : ''}`}
              href={filterHref(tile.key)}
              data-tile={tile.key}
              data-astro-prefetch="false"
              aria-current={tile.key === status ? 'true' : undefined}
            >
              <span class="stat-label">{tile.label}</span>
              <span class="stat-value" data-count={tile.key || 'total'}>
                {tile.value}
              </span>
              <span class="stat-note">{tile.note}</span>
            </a>
          ))}
        </div>

        <div class="card">
          <form method="get" class="toolbar" data-toolbar>
            <div class="field field-search">
              <label for="q">Search</label>
              <div class="search-wrap">
                <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
                  <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                <input
                  id="q"
                  name="q"
                  type="search"
                  value={search}
                  autocomplete="off"
                  placeholder="Tracking #, invoice #, or customer"
                />
                <button class="search-clear" type="button" data-clear-search hidden aria-label="Clear search">
                  ×
                </button>
              </div>
            </div>

            <div class="field">
              <label for="status">Status</label>
              <select id="status" name="status" data-status-select>
                <option value="" selected={status === ''}>
                  All statuses
                </option>
                {(Object.keys(STATUS_LABEL) as Status[]).map((key) => (
                  <option value={key} selected={status === key}>
                    {STATUS_LABEL[key]}
                  </option>
                ))}
              </select>
            </div>

            {/* Sorting is presentation only, so it stays client-side and is
                simply absent when the script has not run. */}
            <div class="field" data-sort-field hidden>
              <label for="sort">Sort by</label>
              <select id="sort" data-sort>
                <option value="newest">Newest first</option>
                <option value="eta">Delivery date</option>
                <option value="progress">Furthest along</option>
                <option value="customer">Customer A–Z</option>
              </select>
            </div>

            <div class="toolbar-end">
              {/* Only needed when the script has not run; JS filters as you type. */}
              <button class="btn btn-soft" type="submit" data-apply>
                Apply
              </button>
              <a
                class="btn btn-ghost"
                href="/tracking/admin"
                data-clear-all
                data-astro-prefetch="false"
                hidden={!search && !status}
              >
                Clear filters
              </a>
            </div>
          </form>

          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Tracking #</th>
                  <th>Customer</th>
                  <th>Route</th>
                  <th>Status</th>
                  <th>Est. delivery</th>
                  <th class="th-actions">Actions</th>
                </tr>
              </thead>
              <tbody data-rows>
                {shipments.map((s, i) => {
                  const bucket = statusOf(s);
                  const late = isOverdue(s);
                  return (
                    <tr
                      data-row
                      data-id={s.id}
                      data-status={bucket}
                      data-overdue={late ? '1' : '0'}
                      data-search={searchText(s)}
                      data-seq={i}
                      data-eta={s.estimated_delivery}
                      data-step={s.current_step}
                      data-step-total={STEP_COUNT}
                      data-customer={s.customer_name.toLowerCase()}
                    >
                      <td data-label="Tracking #">
                        <span class="cell">
                          <strong>{s.tracking_number}</strong>
                          <span class="sub">{s.invoice_number}</span>
                        </span>
                      </td>
                      <td data-label="Customer">{s.customer_name}</td>
                      {/* One wrapper, so the card layout's label/value pair stays a
                          pair instead of spreading the arrow across the row. */}
                      <td data-label="Route" class="route">
                        <span class="route-inner">
                          <span>{s.origin}</span>
                          <span class="arrow" aria-hidden="true">→</span>
                          <span>{s.destination}</span>
                        </span>
                      </td>
                      <td data-label="Status">
                        <span class="status-cell">
                        <span class="badges">
                          <span class={`badge badge-${badgeTone(bucket)}`} data-badge>
                            {STATUS_LABEL[bucket]}
                          </span>
                          <span class="badge badge-late" data-late-badge hidden={!late}>
                            Overdue
                          </span>
                        </span>
                        {/* The real stage name, not a hardcoded one — a renamed
                            stage like "In Salang" still reads correctly here. */}
                        <span class="sub" data-stage>
                          {s.current_step_title ?? `Step ${s.current_step}`} · step {s.current_step} of{' '}
                          {STEP_COUNT}
                        </span>
                        <span class="progress" aria-hidden="true">
                          <i
                            data-bar
                            class={`bar-${badgeTone(bucket)}`}
                            style={`width:${Math.round((s.current_step / STEP_COUNT) * 100)}%`}
                          />
                        </span>
                        </span>
                      </td>
                      <td data-label="Est. delivery" class={late ? 'is-late' : undefined} data-eta-cell>
                        <span class="cell">
                          <span class="date">{formatDate(s.estimated_delivery)}</span>
                          <span class="sub" data-due-hint>{dueHint(s.estimated_delivery, bucket === 'received')}</span>
                        </span>
                      </td>
                      {/* The buttons sit in their own flex box rather than the cell
                          itself: a display:flex <td> drops out of the table's row
                          layout and its bottom border stops lining up. */}
                      <td class="actions">
                        <div class="actions-inner">
                        <form method="post" action="/api/tracker/receive" data-receive hidden={bucket === 'received'}>
                          <input type="hidden" name="id" value={s.id} />
                          <button class="btn btn-ok" type="submit" title="Mark as received">
                            ✓ Received
                          </button>
                        </form>
                        <a class="btn btn-edit" href={`/tracking/admin/${s.id}`}>
                          Edit
                        </a>
                        <form
                          method="post"
                          action={`/tracking/admin/${s.id}`}
                          onsubmit={`return confirm('Delete shipment ${s.tracking_number}? This cannot be undone.');`}
                        >
                          <input type="hidden" name="intent" value="delete" />
                          <button class="btn btn-danger" type="submit">
                            Delete
                          </button>
                        </form>
                        </div>
                      </td>
                    </tr>
                  );
                })}
                <tr data-empty hidden={shipments.length > 0}>
                  <td colspan="6" class="empty" data-empty-text>
                    {loadError
                      ? 'Shipments could not be loaded.'
                      : 'No shipments yet. Use "Add new shipment" to create the first one.'}
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </TrackerAdminLayout>
  )
}

<script>
  import { initDashboard } from '../../../scripts/tracker-dashboard';
  initDashboard();
</script>

---
/**
 * /tracking currently forwards to the order lookup at /tracking/orders.
 *
 * The Postgres-backed shipment tracker is not gone — it still lives at
 * /tracking/shipment, unchanged, with its own data. This page only decides
 * which of the two a customer lands on when they follow "Track Shipment" in
 * the menu, the search box on the home page, or a bare /tracking link.
 *
 * The query string is carried through, so ?code= from the home page's search
 * box arrives as a lookup, and ?lang=ps still opens in Pashto.
 *
 * 307, not 301: this is a temporary arrangement. A permanent redirect would be
 * cached by every browser that saw it and would be painful to take back — and
 * search engines would move the listing to a page marked noindex. To put the
 * tracker back, point this at '/tracking/shipment' instead, or restore the page
 * that used to be here from git.
 */
export const prerender = false;

const target = new URL(Astro.url);
target.pathname = '/tracking/orders';
return Astro.redirect(`${target.pathname}${target.search}`, 307);
---

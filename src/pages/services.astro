---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { getContent } from '../lib/store';

export const prerender = false;

const { exports: EXPORTS, freightModes: freightData, pageHeaders } = await getContent();
const H = pageHeaders.services;

// Freight SVG icons stay fixed by position; title/text come from the admin.
const freightIcons = [
  '<path d="M6 30 L42 30 L37 40 L11 40 Z" stroke="#6b1a33" stroke-width="2" stroke-linejoin="round"/><path d="M24 30 L24 12 L34 20 L24 20" stroke="#6b1a33" stroke-width="2" stroke-linejoin="round"/><path d="M4 36 Q8 39 12 36 T20 36 T28 36 T36 36" stroke="#6b1a33" stroke-width="2"/>',
  '<path d="M6 26 L42 16 L42 22 L18 30 L12 40 L10 40 L13 29 L6 30 Z" stroke="#6b1a33" stroke-width="2" stroke-linejoin="round"/>',
  '<rect x="6" y="18" width="22" height="16" stroke="#6b1a33" stroke-width="2"/><path d="M28 24 L36 24 L42 30 L42 34 L28 34 Z" stroke="#6b1a33" stroke-width="2" stroke-linejoin="round"/><circle cx="15" cy="36" r="3" stroke="#6b1a33" stroke-width="2"/><circle cx="35" cy="36" r="3" stroke="#6b1a33" stroke-width="2"/>',
];
const freightModes = freightData.map((m, i) => ({ ...m, svg: freightIcons[i % freightIcons.length] }));
---

<BaseLayout title="Services" active="/services">
  <!-- ============ PAGE HEADER ============ -->
  <section class="route-grid bg-fig">
    <div class="mx-auto flex max-w-[1240px] flex-col items-start gap-5 px-5 py-16 md:px-10 md:pb-[76px] md:pt-[84px]">
      <Eyebrow text={H.eyebrow} tone="dark" />
      <h1 class="m-0 font-serif text-[38px] font-bold leading-[1.12] text-[#F5F7FA] md:text-[52px]">{H.title}</h1>
      <p class="m-0 max-w-[62ch] text-[17px] leading-relaxed text-[#C6D0DC] md:text-[18px]">
        {H.subtitle}
      </p>
    </div>
  </section>

  <!-- ============ FREIGHT & LOGISTICS ============ -->
  <section class="bg-paper">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-14 px-5 py-20 md:px-10 md:py-24">
      <div class="flex max-w-[680px] flex-col gap-4 reveal">
        <Eyebrow text="Freight & Logistics" />
        <h2 class="m-0 font-serif text-[30px] font-bold leading-tight text-plum md:text-[38px]">Your cargo, moved from Afghanistan to the world.</h2>
        <p class="m-0 text-[16.5px] leading-[1.7] text-muted-dark">
          We arrange the freight, prepare the export documents, clear customs, and handle your cargo at our Kandahar facility — then track it by road, air, or sea until it reaches your buyer. One team, accountable from pickup to delivery.
        </p>
      </div>

      <!-- Freight-mode cards -->
      <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {
          freightModes.map((m) => (
            <div class="flex flex-col gap-4 rounded-xl border border-line bg-cream p-9 reveal">
              <svg width="44" height="44" viewBox="0 0 48 48" fill="none" aria-hidden="true" set:html={m.svg} />
              <h3 class="m-0 font-serif text-[22px] font-bold text-plum">{m.title}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-muted">{m.text}</p>
            </div>
          ))
        }
      </div>

      <!-- Cargo We Carry -->
      <div class="flex flex-col gap-6 border-t border-line pt-5">
        <h3 class="m-0 font-serif text-[26px] font-bold text-plum">Cargo We Carry</h3>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
          {
            EXPORTS.map((e) => (
              <div class="flex flex-col gap-2.5 reveal">
                <ImageFrame src={e.img} alt={e.alt} class="h-[130px] rounded-[10px] md:h-[150px]" label={e.alt} />
                <span class="text-center font-serif text-[16px] font-bold text-plum">{e.name}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="border-y border-line bg-sand">
    <div class="mx-auto flex max-w-[1240px] flex-col items-center gap-5 px-5 py-16 text-center md:px-10 md:py-[76px]">
      <h2 class="m-0 max-w-[24ch] font-serif text-[28px] font-bold leading-tight text-plum md:text-[34px]">Ready to move your cargo?</h2>
      <p class="m-0 max-w-[52ch] text-[16.5px] leading-relaxed text-muted-dark">
        Tell us what you need to ship, from where to where, and we'll respond within one business day with routing, pricing, and timelines.
      </p>
      <a href="/contact#form" class="mt-1.5 rounded-md bg-accent px-8 py-4 text-[15px] font-bold text-ink shadow-[0_2px_8px_rgba(229,154,28,0.28)] transition-colors hover:bg-gold-light">
        Request a Quote
      </a>
    </div>
  </section>
</BaseLayout>

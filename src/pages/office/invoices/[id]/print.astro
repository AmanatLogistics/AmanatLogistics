---
/**
 * Printable A4 invoice — standalone HTML (no office layout), made to be
 * printed or saved as PDF from the browser's print dialog and handed or
 * sent to the client. Letterhead and terms come from Settings; the lines are
 * the shipment's charges; paid-to-date and balance due come from the ledger.
 * A normal invoice (up to ~10 lines) fits on one page.
 */
import { guard } from '../../../../lib/office/auth';
import { getSettings } from '../../../../lib/office/settings';
import { usd, fmtMoney, fmtDate, fmtNum, today } from '../../../../lib/office/money';
import { SERVICES } from '../../../../lib/office/services';
import { INVOICE_STATUS_LABEL } from '../../../../lib/office/invoices';
import { getInvoice, idParam, fmtRateMoney, unitText } from '../../../../lib/office/insights';

export const prerender = false;
const user = await guard(Astro);
if (user instanceof Response) return user;

const id = idParam(Astro.params.id);
const inv = id ? await getInvoice(id, today()) : null;
if (!inv) {
  return new Response('Invoice not found.', { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store' } });
}
const settings = await getSettings();
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const s = inv.shipment;
const svc = SERVICES[s.service];
const multi = inv.byCurrency.length > 1 || (inv.byCurrency.length === 1 && inv.byCurrency[0].currency !== 'USD');
const route = [s.origin, s.destination].filter(Boolean).join(' → ');
const facts: [string, string][] = [];
if (s.awb_no) facts.push(['Airway bill', s.awb_no]);
if (s.tracking_no) facts.push(['Tracking no.', s.tracking_no]);
if (s.pieces !== null) facts.push(['Pieces', fmtNum(s.pieces, 0)]);
if (s.weight_kg !== null) facts.push(['Weight', `${fmtNum(s.weight_kg)} kg`]);
if (s.chargeable_kg !== null) facts.push(['Chargeable', `${fmtNum(s.chargeable_kg)} kg`]);
if (s.cbm !== null) facts.push(['Volume', `${fmtNum(s.cbm, 3)} CBM`]);
facts.push(['Ship date', fmtDate(s.ship_date)]);
facts.push(['Shipment ref', s.ref]);
const stamp = { paid: 'PAID', partial: 'PART PAID', unpaid: 'UNPAID', overdue: 'OVERDUE', credit: 'PAID' }[inv.status];
const back = `/office/invoices/${inv.id}`;
const contactLine = [settings.phone, settings.email, settings.website].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Invoice {inv.number} — {settings.companyName}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Semi+Condensed:wght@600;700&display=swap" rel="stylesheet" />
    <style is:inline>
      @page { size: A4; margin: 14mm; }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: #ecebea;
        color: #1f1419;
        font-family: 'Barlow', 'Helvetica Neue', Arial, sans-serif;
        font-size: 13px;
        line-height: 1.4;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      a { color: #7e2e47; }
      .toolbar {
        position: sticky; top: 0; z-index: 5;
        display: flex; gap: 10px; align-items: center; justify-content: space-between; flex-wrap: wrap;
        padding: 10px 16px; background: #2a1019; color: #ead6dd;
      }
      .toolbar a { color: #fff; font-weight: 600; text-decoration: none; }
      .toolbar .hint { font-size: 12.5px; color: #c9a3b1; }
      .toolbar button {
        font: inherit; font-weight: 700; font-size: 14px; cursor: pointer;
        background: #7e2e47; color: #fff; border: 1px solid #a2486a; border-radius: 8px; padding: 9px 16px;
      }
      .sheet {
        width: 210mm; min-height: 297mm; margin: 20px auto; padding: 14mm;
        background: #fff; box-shadow: 0 2px 18px rgba(0, 0, 0, 0.12);
      }
      @media (max-width: 820px) {
        .sheet { width: auto; min-height: 0; margin: 12px; padding: 18px 16px; }
      }
      @media print {
        body { background: #fff; font-size: 12px; }
        .no-print { display: none !important; }
        .sheet { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
      }

      /* letterhead */
      .head { display: flex; align-items: center; gap: 14px; }
      .head img { width: 64px; height: auto; flex: none; }
      .co { flex: 1; min-width: 0; }
      .co .name { font-family: 'Barlow Semi Condensed', 'Barlow', 'Arial Narrow', Arial, sans-serif; font-size: 25px; font-weight: 700; color: #7e2e47; line-height: 1.05; letter-spacing: 0.01em; }
      .co .tag { color: #6c5f65; font-size: 12.5px; margin-top: 2px; }
      .contact { text-align: right; font-size: 11.5px; color: #463a40; white-space: pre-line; max-width: 46%; }
      .rule { height: 3px; background: #7e2e47; margin: 12px 0 4px; border-radius: 2px; }
      .rule2 { height: 1px; background: #e6dde1; margin: 0 0 16px; }

      /* title */
      .title { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 16px; }
      h1 { font-family: 'Barlow Semi Condensed', 'Barlow', 'Arial Narrow', Arial, sans-serif; font-size: 34px; letter-spacing: 0.08em; margin: 0; color: #2a1019; line-height: 1; }
      .stamp {
        display: inline-block; margin-top: 8px; padding: 3px 10px; border: 2px solid currentColor; border-radius: 4px;
        font-weight: 700; font-size: 12px; letter-spacing: 0.12em;
      }
      .stamp.paid, .stamp.credit { color: #1e7b4f; }
      .stamp.partial { color: #a15c07; }
      .stamp.unpaid { color: #7e2e47; }
      .stamp.overdue { color: #b42318; }
      table.meta { border-collapse: collapse; font-size: 12.5px; }
      table.meta th { text-align: left; font-weight: 500; color: #6c5f65; padding: 2px 14px 2px 0; white-space: nowrap; }
      table.meta td { text-align: right; font-weight: 700; padding: 2px 0; white-space: nowrap; }

      /* bill to + shipment */
      .boxes { display: grid; grid-template-columns: 1fr 1.45fr; gap: 12px; margin-bottom: 16px; }
      .box { border: 1px solid #e6dde1; border-radius: 8px; padding: 10px 12px; break-inside: avoid; }
      .box h2 { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #7e2e47; margin: 0 0 6px; font-weight: 700; }
      .box .who { font-size: 15px; font-weight: 700; }
      .box .line { color: #463a40; }
      .box .svc { font-weight: 700; }
      .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px 14px; margin-top: 6px; font-size: 12px; }
      .facts div { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px dotted #e6dde1; padding: 1px 0; }
      .facts span { color: #6c5f65; white-space: nowrap; }
      .facts b { font-weight: 600; text-align: right; overflow-wrap: anywhere; }
      .goods { margin-top: 6px; font-size: 12px; }
      .goods span { color: #6c5f65; }

      /* lines */
      table.lines { width: 100%; border-collapse: collapse; margin-bottom: 4px; }
      table.lines thead tr { background: #7e2e47; }
      table.lines th {
        color: #fff; font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase;
        text-align: left; padding: 7px 8px; font-weight: 700;
      }
      table.lines td { padding: 7px 8px; border-bottom: 1px solid #efe7eb; vertical-align: top; }
      table.lines tr { break-inside: avoid; }
      .num { text-align: right !important; font-variant-numeric: tabular-nums; white-space: nowrap; }
      .muted { color: #6c5f65; }
      .small { font-size: 11px; }

      /* totals */
      .bottom { display: grid; grid-template-columns: 1fr 300px; gap: 20px; margin-top: 10px; break-inside: avoid; }
      table.totals { width: 100%; border-collapse: collapse; font-size: 13px; }
      table.totals td { padding: 4px 8px; }
      table.totals tr.sub td { color: #463a40; font-size: 12px; }
      table.totals tr.total td { border-top: 2px solid #2a1019; font-weight: 700; font-size: 14px; padding-top: 7px; }
      table.totals tr.paid td { color: #463a40; }
      table.totals tr.due td { background: #f3ebee; font-weight: 700; font-size: 16px; color: #2a1019; padding: 8px; }
      table.totals tr.due td:first-child { border-radius: 6px 0 0 6px; }
      table.totals tr.due td:last-child { border-radius: 0 6px 6px 0; }
      table.totals tr.due.zero td { background: #e6f4ec; color: #1e7b4f; }
      .notes h3 { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: #7e2e47; margin: 0 0 4px; }
      .notes p { margin: 0 0 12px; white-space: pre-line; font-size: 12px; color: #2a1019; }

      /* signatures & footer */
      .sign { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 34px; break-inside: avoid; }
      .sign div { border-top: 1px solid #2a1019; padding-top: 5px; font-size: 11.5px; color: #463a40; }
      .foot { margin-top: 22px; padding-top: 8px; border-top: 1px solid #e6dde1; text-align: center; font-size: 11.5px; color: #6c5f65; }
      .foot strong { color: #7e2e47; }
      @media (max-width: 640px) {
        .head { flex-wrap: wrap; }
        .contact { text-align: left; max-width: none; width: 100%; }
        .title { flex-direction: column; }
        .boxes, .bottom { grid-template-columns: 1fr; }
        .facts { grid-template-columns: 1fr; }
        .lines-wrap { overflow-x: auto; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar no-print">
      <a href={back}>← Back to invoice</a>
      <span class="hint">To save a PDF, choose “Save as PDF” in the print window.</span>
      <button type="button" id="print-btn">Print / save as PDF</button>
    </div>

    <main class="sheet">
      <header class="head">
        <img src="/images/brand-logo-maroon.png" alt={settings.companyName} width="64" height="61" />
        <div class="co">
          <div class="name">{settings.companyName}</div>
          {settings.companyTagline && <div class="tag">{settings.companyTagline}</div>}
        </div>
        <div class="contact">
          {settings.address}
          {contactLine.length > 0 && `\n${contactLine.join(' · ')}`}
        </div>
      </header>
      <div class="rule"></div>
      <div class="rule2"></div>

      <section class="title">
        <div>
          <h1>INVOICE</h1>
          <div class:list={['stamp', inv.status]} title={INVOICE_STATUS_LABEL[inv.status]}>{stamp}</div>
        </div>
        <table class="meta">
          <tbody>
            <tr><th>Invoice no.</th><td>{inv.number}</td></tr>
            <tr><th>Invoice date</th><td>{fmtDate(inv.issue_date)}</td></tr>
            <tr><th>Due date</th><td>{inv.due_date ? fmtDate(inv.due_date) : 'On receipt'}</td></tr>
            <tr><th>Shipment</th><td>{s.ref}</td></tr>
          </tbody>
        </table>
      </section>

      <section class="boxes">
        <div class="box">
          <h2>Bill to</h2>
          {
            inv.client ? (
              <>
                <div class="who">{inv.client.name}</div>
                {inv.client.phone && <div class="line">{inv.client.phone}</div>}
                {(inv.client.city || inv.client.country) && <div class="line">{[inv.client.city, inv.client.country].filter(Boolean).join(', ')}</div>}
              </>
            ) : (
              <div class="muted">—</div>
            )
          }
        </div>
        <div class="box">
          <h2>Shipment</h2>
          <div class="svc">{svc?.label ?? s.service}</div>
          {route && <div class="line">{route}</div>}
          <div class="facts">
            {facts.map(([k, v]) => (
              <div><span>{k}</span><b>{v}</b></div>
            ))}
          </div>
          {s.goods && <div class="goods"><span>Goods:</span> {s.goods}</div>}
        </div>
      </section>

      <div class="lines-wrap">
        <table class="lines">
          <thead>
            <tr>
              <th style="width:44%">Description</th>
              <th class="num">Qty</th>
              <th>Unit</th>
              <th class="num">Rate</th>
              <th class="num">Amount</th>
            </tr>
          </thead>
          <tbody>
            {
              inv.charges.length === 0 && (
                <tr><td colspan="5" class="muted">No charges.</td></tr>
              )
            }
            {
              inv.charges.map((c) => (
                <tr>
                  <td>{c.description}</td>
                  <td class="num">{c.qty !== null ? fmtNum(c.qty, 3) : '—'}</td>
                  <td>{c.unit === 'fixed' ? 'fixed' : unitText(c.unit, c.qty) || '—'}</td>
                  <td class="num">{c.rate !== null ? fmtRateMoney(c.rate, c.currency) : '—'}</td>
                  <td class="num">
                    {fmtMoney(c.amount, c.currency)}
                    {c.currency !== 'USD' && <div class="small muted">{usd(c.usd)}</div>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <section class="bottom">
        <div class="notes">
          {
            inv.notes && (
              <>
                <h3>Note</h3>
                <p>{inv.notes}</p>
              </>
            )
          }
          {
            settings.paymentInstructions && (
              <>
                <h3>How to pay</h3>
                <p>{settings.paymentInstructions}</p>
              </>
            )
          }
          {
            multi && (
              <p class="small muted">
                Amounts in other currencies are converted to US dollars at the rate on each line
                {inv.byCurrency
                  .filter((b) => b.currency !== 'USD')
                  .map((b) => ` (${b.rates.map((r) => `${fmtNum(r, 4)} ${b.currency}`).join(' / ')} = $1)`)
                  .join('')}.
              </p>
            )
          }
        </div>
        <table class="totals">
          <tbody>
            {
              multi &&
                inv.byCurrency.map((b) => (
                  <tr class="sub">
                    <td>Subtotal {b.currency}</td>
                    <td class="num">
                      {fmtMoney(b.amount, b.currency)}
                      {b.currency !== 'USD' && <span class="muted"> = {usd(b.usd)}</span>}
                    </td>
                  </tr>
                ))
            }
            <tr class="total"><td>Total (USD)</td><td class="num">{usd(inv.fig.revenue)}</td></tr>
            <tr class="paid"><td>Paid to date (USD)</td><td class="num">{usd(inv.fig.received)}</td></tr>
            <tr class:list={['due', inv.fig.due <= 0 && 'zero']}>
              <td>{inv.fig.due < 0 ? 'Credit in your favour (USD)' : 'Balance due (USD)'}</td>
              <td class="num">{usd(Math.abs(inv.fig.due))}</td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="sign">
        <div>Authorised signature &amp; stamp — {settings.companyName}</div>
        <div>Received by (client) — name, signature &amp; date</div>
      </section>

      <footer class="foot">
        {settings.invoiceFooter && <div><strong>{settings.invoiceFooter}</strong></div>}
        <div>{[settings.companyName, settings.website].filter(Boolean).join(' · ')}</div>
      </footer>
    </main>

    <script is:inline>
      document.getElementById('print-btn').addEventListener('click', function () {
        window.print();
      });
    </script>
  </body>
</html>

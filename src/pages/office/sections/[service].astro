---
/**
 * One line of business (UPS courier, China CBM, Tashkent air, Kabul air,
 * other): its shipments in the chosen period, and — for admins — what they
 * earned and cost, where the cost goes, a 12-month chart and which partners
 * on this route we still owe. Staff see the same page without cost, profit
 * or margin.
 *
 *   /office/sections/<ups|china|tashkent|kabul_air|other>?period=…
 */
import OfficeLayout from '../../../layouts/OfficeLayout.astro';
import PageHead from '../../../components/office/PageHead.astro';
import Flash from '../../../components/office/Flash.astro';
import Stat from '../../../components/office/Stat.astro';
import PeriodPicker from '../../../components/office/PeriodPicker.astro';
import BarChart from '../../../components/office/BarChart.astro';
import { guard, isAdmin } from '../../../lib/office/auth';
import { pnl, monthlyPnl } from '../../../lib/office/ledger';
import { usd, fmtDate, fmtNum, today } from '../../../lib/office/money';
import { SERVICES, isService } from '../../../lib/office/services';
import {
  sectionShipments,
  sectionPartners,
  last12Months,
  margin,
  fmtPct,
  tone,
  kgOf,
  costCategoryLabel,
  partyKindLabel,
  statusLabel,
  routeText,
  periodQuery,
  periodRangeText,
  pageParam,
  periodFromQuery,
} from '../../../lib/office/insights';

export const prerender = false;
const user = await guard(Astro);
if (user instanceof Response) return user;
const admin = isAdmin(user);

const key = Astro.params.service;
const known = isService(key);
if (!known) Astro.response.status = 404;

const todayStr = today();
const period = periodFromQuery(Astro.url.searchParams, todayStr);
const periodName = period.key === 'custom' ? periodRangeText(period) : period.label;
const svc = known ? SERVICES[key] : null;
const cbm = svc?.unit === 'cbm';
const unit = cbm ? 'CBM' : 'kg';

const [list, partners, p, months] = known
  ? await Promise.all([
      sectionShipments(key, period, pageParam(Astro.url.searchParams)),
      sectionPartners(key),
      admin ? pnl(period, key) : Promise.resolve(null),
      admin ? monthlyPnl(last12Months(todayStr), key) : Promise.resolve([]),
    ])
  : [null, [], null, []];

const t = list?.totals;
const measure = t ? (cbm ? t.cbm : t.kg) : 0;
const fmtMeasure = (v: number | null) => (v === null ? '—' : cbm ? `${fmtNum(v, 3)} CBM` : `${fmtNum(v)} kg`);
// only shipments that have a weight / volume entered count towards "profit per kg / CBM"
const unitProfit = t ? (cbm ? t.cbmProfit : t.kgProfit) : 0;
const unmeasured = t ? (cbm ? t.noCbm : t.noKg) : 0;
const profitPerUnit = admin && measure ? unitProfit / measure : null;
const costTotal = p ? p.costByCategory.reduce((a, c) => a + c.usd, 0) : 0;
const weOwe = partners.filter((x) => x.balance < 0);
const others = partners.filter((x) => x.balance >= 0);
const pq = periodQuery(period);
const pageLink = (n: number) => `/office/sections/${key}?${pq}${n > 1 ? `&page=${n}` : ''}`;
const cols = admin ? 9 : 7;
const TILES = 'grid-template-columns:repeat(auto-fit,minmax(150px,1fr))';
---

<OfficeLayout title={svc ? svc.short : 'Section not found'} user={user} active={known ? `section-${key}` : ''} wide>
  {
    !svc || !list || !t ? (
      <>
        <PageHead title="Section not found" crumbs={[{ label: 'Office', href: '/office' }]} />
        <div class="o-card o-empty">
          There is no section called “{key}”. Choose one from the menu, or go back to the <a href="/office">dashboard</a>.
        </div>
      </>
    ) : (
      <>
        <PageHead title={svc.label} sub={svc.route} crumbs={[{ label: 'Office', href: '/office' }, { label: 'Sections', href: '/office' }]}>
          <a class="o-btn primary" href={`/office/shipments/new?service=${key}`}>New {svc.short} shipment</a>
          <a class="o-btn" href={`/office/shipments?service=${key}&from=${period.from}&to=${period.to}`} data-astro-prefetch="false">
            Open in shipments list
          </a>
        </PageHead>
        <Flash />
        <PeriodPicker period={period} action={`/office/sections/${key}`} />

        <div class="o-stats" style={TILES}>
          <Stat label="Shipments" value={fmtNum(t.count, 0)} sub={periodName} />
          <Stat label={cbm ? 'Total CBM' : 'Total kg'} value={cbm ? fmtNum(t.cbm, 3) : fmtNum(t.kg)} sub={cbm ? 'Cubic metres' : 'Chargeable weight'} />
          {admin && p ? (
            <>
              <Stat label="Revenue" value={usd(p.revenue)} sub="Billed to clients" />
              <Stat label="Cost" value={usd(p.directCost)} sub="Paid or owed to partners" />
            </>
          ) : null}
          {!admin && (
            <>
              <Stat label="Billed" value={usd(t.revenue)} sub="Charged to clients" />
              <Stat label="Received" value={usd(t.received)} sub="Paid for these shipments" />
              <Stat label="Still to collect" value={usd(t.due)} sub={t.due < 0 ? 'Clients paid more than billed' : 'Billed, not yet paid'} />
            </>
          )}
        </div>
        {admin && p && (
          <div class="o-stats" style={TILES}>
              <Stat label="Gross profit" value={usd(p.grossProfit)} tone={tone(p.grossProfit)} sub="Revenue minus cost" />
              <Stat label="Margin" value={fmtPct(margin(p.grossProfit, p.revenue))} sub="Profit out of each $100 billed" tone={tone(p.grossProfit)} />
              <Stat
                label={`Profit per ${unit}`}
                value={profitPerUnit === null ? '—' : usd(profitPerUnit)}
                sub={
                  profitPerUnit === null
                    ? `No ${unit} recorded`
                    : `Average over ${fmtMeasure(measure)}${unmeasured ? ` — ${unmeasured} shipment${unmeasured === 1 ? '' : 's'} without ${unit} left out` : ''}`
                }
                tone={profitPerUnit === null ? '' : tone(profitPerUnit)}
              />
          </div>
        )}

        {admin && p && (
          <div class="o-grid-2">
            <div class="o-card">
              <div class="o-card-head">
                <h2>Where the cost goes</h2>
                <span class="small muted">{periodName}</span>
              </div>
              {p.costByCategory.length === 0 ? (
                <p class="o-empty">No costs recorded for shipments in this period.</p>
              ) : (
                <div class="o-table-wrap">
                  <table class="o-table">
                    <thead>
                      <tr><th>Cost</th><th class="num">Amount</th><th class="num">Share</th></tr>
                    </thead>
                    <tbody>
                      {p.costByCategory.map((c) => {
                        const share = costTotal ? (c.usd / costTotal) * 100 : 0;
                        return (
                          <tr>
                            <td>
                              {costCategoryLabel(c.category)}
                              <div class="o-bar" style="margin-top:6px" aria-hidden="true"><span style={`width:${Math.max(1, share)}%`} /></div>
                            </td>
                            <td class="num">{usd(c.usd)}</td>
                            <td class="num muted">{fmtPct(share, 0)}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                    <tfoot>
                      <tr><td>Total cost</td><td class="num">{usd(p.directCost)}</td><td class="num"></td></tr>
                    </tfoot>
                  </table>
                </div>
              )}
              {p.revenue > 0 && (
                <p class="small muted" style="margin:12px 0 0">
                  Out of every $100 billed on this route, {usd(Math.min(100, (p.directCost / p.revenue) * 100))} went on costs
                  {p.grossProfit >= 0 ? ` and ${usd((p.grossProfit / p.revenue) * 100)} was profit.` : ` — costs were more than revenue.`}
                </p>
              )}
            </div>
            <div class="o-card">
              <div class="o-card-head">
                <h2>Last 12 months</h2>
                <span class="small muted">This section only</span>
              </div>
              <BarChart rows={months} title={`${svc.short}: revenue, direct costs and gross profit for each of the last 12 months`} combineExpenses={false} height={190} />
            </div>
          </div>
        )}

        <div class="o-card" style="margin-top:16px">
          <div class="o-card-head">
            <h2>Shipments — {periodName}</h2>
            <span class="small muted">{fmtNum(t.count, 0)} shipment{t.count === 1 ? '' : 's'}</span>
          </div>
          <div class="o-table-wrap">
            <table class="o-table">
              <thead>
                <tr>
                  <th>Shipment</th>
                  <th>Client</th>
                  <th class="num">{cbm ? 'CBM' : 'Kg'}</th>
                  <th class="num">Billed</th>
                  <th class="num">Received</th>
                  <th class="num">Due</th>
                  {admin && <th class="num">Cost</th>}
                  {admin && <th class="num">Profit</th>}
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {list.rows.length === 0 && (
                  <tr>
                    <td colspan={cols} class="o-empty">
                      No {svc.short} shipments in this period. <a href={`/office/shipments/new?service=${key}`}>Enter one</a> or choose another period.
                    </td>
                  </tr>
                )}
                {list.rows.map((s) => (
                  <tr>
                    <td style="white-space:nowrap">
                      <a href={`/office/shipments/${s.id}`} data-astro-prefetch="false"><strong>{s.ref}</strong></a>
                      <div class="small muted">{fmtDate(s.ship_date)}</div>
                    </td>
                    <td style="min-width:130px">
                      {s.client_id ? <a href={`/office/parties/${s.client_id}`} data-astro-prefetch="false">{s.client_name}</a> : <span class="muted">—</span>}
                      <div class="small muted">{routeText(s)}</div>
                    </td>
                    <td class="num">{fmtMeasure(cbm ? s.cbm : kgOf(s)).replace(/ (kg|CBM)$/, '')}</td>
                    <td class="num">{usd(s.fig.revenue)}</td>
                    <td class="num">{s.fig.received ? usd(s.fig.received) : <span class="muted">{usd(0)}</span>}</td>
                    <td class="num">
                      {s.fig.due > 0 ? <strong>{usd(s.fig.due)}</strong> : s.fig.due < 0 ? <span class="small">Overpaid {usd(-s.fig.due)}</span> : <span class="muted">{usd(0)}</span>}
                    </td>
                    {admin && <td class="num">{usd(s.fig.cost)}</td>}
                    {admin && <td class:list={['num', tone(s.fig.profit)]}>{usd(s.fig.profit)}</td>}
                    <td><span class:list={['o-badge', s.status]}>{statusLabel(s.status)}</span></td>
                  </tr>
                ))}
              </tbody>
              {t.count > 0 && (
                <tfoot>
                  <tr>
                    <td colspan="2">Total{list.pages > 1 ? ` (all ${fmtNum(t.count, 0)})` : ''}</td>
                    <td class="num">{fmtMeasure(measure).replace(/ (kg|CBM)$/, '')}</td>
                    <td class="num">{usd(t.revenue)}</td>
                    <td class="num">{usd(t.received)}</td>
                    <td class="num">{usd(t.due)}</td>
                    {admin && <td class="num">{usd(t.cost)}</td>}
                    {admin && <td class:list={['num', tone(t.profit)]}>{usd(t.profit)}</td>}
                    <td></td>
                  </tr>
                </tfoot>
              )}
            </table>
          </div>
          {list.pages > 1 && (
            <div class="o-actions" style="margin-top:12px;justify-content:space-between">
              <span class="small muted">Page {list.page} of {list.pages}</span>
              <span class="o-actions">
                {list.page > 1 && <a class="o-btn sm" href={pageLink(list.page - 1)} data-astro-prefetch="false">← Newer</a>}
                {list.page < list.pages && <a class="o-btn sm" href={pageLink(list.page + 1)} data-astro-prefetch="false">Older →</a>}
              </span>
            </div>
          )}
        </div>

        <div class="o-card" style="margin-top:16px">
          <div class="o-card-head">
            <h2>Partners we owe on this route</h2>
            <span class="small muted">Their whole balance, all sections, today</span>
          </div>
          {weOwe.length === 0 ? (
            <p class="o-empty">
              {partners.length === 0 ? 'No partners have been entered on this route’s cost lines yet.' : 'We don’t owe any partner on this route anything right now.'}
            </p>
          ) : (
            <div class="o-table-wrap">
              <table class="o-table">
                <thead>
                  <tr>
                    <th>Partner</th>
                    {admin && <th class="num">Charged us on this route</th>}
                    <th class="num">We owe them</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {weOwe.map((x) => (
                    <tr>
                      <td>
                        <a href={`/office/parties/${x.id}`} data-astro-prefetch="false">{x.name}</a>
                        <div class="small muted">{partyKindLabel(x.kind)}{x.city ? ` · ${x.city}` : ''}</div>
                      </td>
                      {admin && <td class="num">{usd(x.charged)}</td>}
                      <td class="num neg"><strong>{usd(-x.balance)}</strong></td>
                      <td style="text-align:right">
                        <a class="o-btn sm" href={`/office/payments/new?dir=out&party=${x.id}`} data-astro-prefetch="false">Pay</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr>
                    <td>Total</td>
                    {admin && <td class="num"></td>}
                    <td class="num">{usd(-weOwe.reduce((a, x) => a + x.balance, 0))}</td>
                    <td></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          )}
          {others.length > 0 && (
            <details style="margin-top:12px">
              <summary class="small" style="cursor:pointer;color:var(--o-maroon);font-weight:600">
                {others.length} other partner{others.length === 1 ? '' : 's'} on this route — settled, or they owe us
              </summary>
              <ul class="small" style="margin:8px 0 0;padding-left:18px">
                {others.map((x) => (
                  <li>
                    <a href={`/office/parties/${x.id}`} data-astro-prefetch="false">{x.name}</a>{' '}
                    <span class="muted">— {x.balance > 0 ? `owes us ${usd(x.balance)}` : 'settled'}</span>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>
      </>
    )
  }
</OfficeLayout>

<style>
  .o-grid-2 > .o-card { min-width: 0; }
  @media (max-width: 600px) {
    .o-stats { gap: 8px; }
    .o-stats :global(.o-stat) { padding: 10px 12px; }
    .o-stats :global(.value) { font-size: 21px; }
    .o-stats :global(.label) { font-size: 11px; letter-spacing: 0.04em; }
  }
</style>

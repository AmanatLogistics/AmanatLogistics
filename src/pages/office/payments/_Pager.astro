---
/**
 * "Showing 51–100 of 230 · ← Newer · Page 2 of 5 · Older →" for the money
 * lists (50 a page). Keeps every filter in the URL. Not a route (leading _).
 */
import { withParams, PAGE_SIZE } from '../../../lib/office/entries';

interface Props {
  page: number;
  pages: number;
  count: number;
  noun?: string;
}
const { page, pages, count, noun = 'entries' } = Astro.props;
const href = (p: number) => withParams(Astro.url, { page: p > 1 ? p : null });
const first = count === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
const last = Math.min(count, page * PAGE_SIZE);
---

{
  count > 0 && (
    <nav class="o-actions no-print" style="justify-content:space-between;margin-top:12px" aria-label="Pages">
      <span class="muted small">
        {pages > 1 ? `Showing ${first}–${last} of ${count} ${noun}` : `${count} ${count === 1 ? noun.replace(/s$/, '') : noun}`}
      </span>
      {pages > 1 && (
        <span class="o-actions">
          {page > 1 ? <a class="o-btn sm" href={href(page - 1)}>← Newer</a> : <span class="o-btn sm" aria-disabled="true" style="opacity:.45;cursor:default">← Newer</span>}
          <span class="small muted">Page {page} of {pages}</span>
          {page < pages ? <a class="o-btn sm" href={href(page + 1)}>Older →</a> : <span class="o-btn sm" aria-disabled="true" style="opacity:.45;cursor:default">Older →</span>}
        </span>
      )}
    </nav>
  )
}

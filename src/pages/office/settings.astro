---
/**
 * Settings (admin only): the letterhead printed on invoices, payment terms,
 * numbering prefixes, today's exchange rates (used to pre-fill forms; each
 * record keeps the rate it was entered with, so changing a rate never rewrites
 * old figures), and who gets the backup and the unpaid-clients reminder.
 */
import OfficeLayout from '../../layouts/OfficeLayout.astro';
import PageHead from '../../components/office/PageHead.astro';
import Flash from '../../components/office/Flash.astro';
import { guard, sameOrigin } from '../../lib/office/auth';
import { q } from '../../lib/office/db';
import { getSettings, saveSettings } from '../../lib/office/settings';
import { listCurrencies } from '../../lib/office/money';
import { logActivity } from '../../lib/office/activity';
import { str, int, parseNum, withMsg } from '../../lib/office/form';
import { fmtDate } from '../../lib/office/money';
import { buildBackup } from '../../lib/office/backup';
import {
  runBackup,
  backupState,
  nextDue,
  channels,
  normalizePhone,
  isEmail,
  showPhone,
  saveWhatsapp,
  forgetWhatsapp,
  whatsappConfig,
  checkWhatsapp,
  type SendResult,
} from '../../lib/office/delivery';

export const prerender = false;
const user = await guard(Astro, { admin: true });
if (user instanceof Response) return user;

// Download the backup now, without sending it anywhere.
const dl = Astro.url.searchParams.get('download');
if (dl === 'xlsx' || dl === 'restore') {
  const b = await buildBackup();
  await logActivity(user.id, 'backup_downloaded', 'backup', null, dl === 'xlsx' ? 'Excel backup downloaded' : 'Restore file downloaded');
  const [body, type, name] =
    dl === 'xlsx'
      ? [new Uint8Array(b.xlsx), 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', `amanat-office-backup-${b.date}.xlsx`]
      : [b.restoreCsv, 'text/csv; charset=utf-8', `amanat-office-restore-${b.date}.csv`];
  return new Response(body, { headers: { 'content-type': type, 'content-disposition': `attachment; filename="${name}"`, 'cache-control': 'no-store', 'x-robots-tag': 'noindex' } });
}

let error: string | null = null;
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) error = 'That request looked unsafe, so it was blocked.';
  else {
    const fd = await Astro.request.formData();
    if (fd.get('action') === 'company') {
      const dueDays = int(fd, 'dueDays');
      const prefix = (s: string | null, d: string) => (s ?? d).toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 8) || d;
      await saveSettings({
        companyName: str(fd, 'companyName', 120) ?? 'Amanat Logistics',
        companyTagline: str(fd, 'companyTagline', 160) ?? '',
        address: str(fd, 'address', 300) ?? '',
        phone: str(fd, 'phone', 80) ?? '',
        email: str(fd, 'email', 120) ?? '',
        website: str(fd, 'website', 120) ?? '',
        paymentInstructions: str(fd, 'paymentInstructions', 1000) ?? '',
        invoiceFooter: str(fd, 'invoiceFooter', 500) ?? '',
        invoicePrefix: prefix(str(fd, 'invoicePrefix', 8), 'INV'),
        shipmentPrefix: prefix(str(fd, 'shipmentPrefix', 8), 'AML'),
        dueDays: dueDays !== null && dueDays >= 0 && dueDays <= 365 ? dueDays : 15,
      });
      await logActivity(user.id, 'settings_updated', 'settings', null, 'Company & invoice settings');
      return Astro.redirect(withMsg('/office/settings', 'Settings saved.'), 303);
    }
    if (fd.get('action') === 'backup_settings') {
      const lines = (name: string) => String(fd.get(name) ?? '').split(/[\n,;]+/).map((x) => x.trim()).filter(Boolean);
      const emails = lines('backupEmails');
      const badEmails = emails.filter((e) => !isEmail(e));
      const phones = lines('backupWhatsapp').map((p) => [p, normalizePhone(p)] as const);
      const reminderRaw = str(fd, 'reminderWhatsapp', 40);
      const reminder = reminderRaw ? normalizePhone(reminderRaw) : '';
      const every = int(fd, 'backupEveryDays');
      const bad = [...badEmails.map((e) => `"${e}" is not an email address`), ...phones.filter(([, n]) => !n).map(([p]) => `"${p}" is not a phone number`)];
      if (reminderRaw && !reminder) bad.push(`"${reminderRaw}" is not a phone number`);
      if (every === null || every < 1 || every > 30) bad.push('“Every … days” must be between 1 and 30');
      if (bad.length) error = `Not saved: ${bad.join('; ')}. Write WhatsApp numbers with the country code, e.g. +93 70 280 0277.`;
      else {
        await saveSettings({
          backupEmails: [...new Set(emails.map((e) => e.toLowerCase()))],
          backupWhatsapp: [...new Set(phones.map(([, n]) => n!))],
          reminderWhatsapp: reminder ?? '',
          backupEveryDays: every!,
        });
        await logActivity(user.id, 'settings_updated', 'settings', null, `Backups: ${emails.length} email, ${phones.length} WhatsApp, reminder ${reminder ? 'on' : 'off'}, every ${every} days`);
        return Astro.redirect(withMsg('/office/settings', 'Backup settings saved.') + '#backups', 303);
      }
    }
    if (fd.get('action') === 'whatsapp') {
      const phoneId = (str(fd, 'phoneId', 40) ?? '').replace(/\s+/g, '');
      const token = (str(fd, 'token', 1000) ?? '').replace(/\s+/g, '');
      const name = (k: string, d: string) => (str(fd, k, 60) ?? d).toLowerCase().replace(/[^a-z0-9_]/g, '') || d;
      const lang = (str(fd, 'lang', 10) ?? 'en').replace(/[^A-Za-z_]/g, '') || 'en';
      if (!/^\d{5,25}$/.test(phoneId)) error = 'The Phone number ID is the long number on Meta’s “API Setup” page (only digits).';
      else {
        const saved = await whatsappConfig();
        const candidate = { token: token || saved.token, phoneId, backupTemplate: name('backupTemplate', 'office_backup'), reminderTemplate: name('reminderTemplate', 'unpaid_reminder'), lang };
        const check = await checkWhatsapp(candidate);
        if (!check.ok) error = `WhatsApp did not accept these details, so they were not saved: ${check.error}`;
        else {
          await saveWhatsapp({ ...candidate, token });
          await logActivity(user.id, 'settings_updated', 'settings', null, `WhatsApp connected: ${check.number}${check.name ? ` (${check.name})` : ''}`);
          return Astro.redirect(withMsg('/office/settings', `WhatsApp connected — messages will come from ${check.number}${check.name ? ` (${check.name})` : ''}.`) + '#whatsapp', 303);
        }
      }
    }
    if (fd.get('action') === 'whatsapp_forget') {
      await forgetWhatsapp();
      await logActivity(user.id, 'settings_updated', 'settings', null, 'WhatsApp disconnected');
      return Astro.redirect(withMsg('/office/settings', 'WhatsApp disconnected. Its access token was deleted from the office.') + '#whatsapp', 303);
    }
    if (fd.get('action') === 'backup_now') {
      try {
        const r = await runBackup({ force: true, trigger: 'manual', userId: user.id });
        if ('skipped' in r) error = r.skipped;
        else {
          const all = [...r.report.email, ...r.report.whatsapp, ...(r.report.reminder ? [r.report.reminder] : [])];
          const ok = all.filter((x) => x.ok).length;
          const msg = all.length ? `Backup sent: ${ok} of ${all.length} messages went out.${ok < all.length ? ' See below for what did not.' : ''}` : 'Nothing to send to — add email addresses or WhatsApp numbers below.';
          return Astro.redirect(withMsg('/office/settings', msg, ok === all.length && all.length ? 'ok' : 'err') + '#backups', 303);
        }
      } catch (e) {
        console.error('Backup failed:', e);
        error = `The backup could not be sent: ${e instanceof Error ? e.message : String(e)}`;
      }
    }
    if (fd.get('action') === 'rates') {
      const changed: string[] = [];
      for (const c of await listCurrencies()) {
        if (c.code === 'USD') continue;
        const v = parseNum(fd.get(`rate_${c.code}`));
        if (v !== null && v > 0 && v !== c.per_usd) {
          await q('UPDATE office_currencies SET per_usd = $1, updated_at = now() WHERE code = $2', [v, c.code]);
          changed.push(`${c.code} ${v}`);
        }
      }
      const newCode = (str(fd, 'new_code', 3) ?? '').toUpperCase();
      const newName = str(fd, 'new_name', 40);
      const newRate = parseNum(fd.get('new_rate'));
      if (newCode) {
        if (!/^[A-Z]{3}$/.test(newCode) || !newName || !newRate || newRate <= 0) {
          error = 'To add a currency give a 3-letter code, a name and how many make one US dollar.';
        } else {
          await q('INSERT INTO office_currencies (code, name, per_usd) VALUES ($1, $2, $3) ON CONFLICT (code) DO NOTHING', [newCode, newName, newRate]);
          changed.push(`added ${newCode}`);
        }
      }
      if (!error) {
        if (changed.length) await logActivity(user.id, 'rates_updated', 'settings', null, changed.join(', '));
        return Astro.redirect(withMsg('/office/settings', changed.length ? 'Rates saved.' : 'No rates changed.'), 303);
      }
    }
  }
}

const s = await getSettings();
const currencies = await listCurrencies();
const ch = await channels();
const bs = await backupState();
const due = nextDue(bs, s);
const when = (iso: string) => new Date(iso).toLocaleString('en-GB', { timeZone: 'Asia/Kabul', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
const result = (r: SendResult, phone = false) => `${phone ? showPhone(r.to) : r.to} — ${r.ok ? 'sent' : `not sent: ${r.error ?? 'unknown error'}`}`;
---

<OfficeLayout title="Settings" user={user} active="settings">
  <PageHead title="Settings" sub="What prints on invoices, and today's exchange rates." />
  <Flash error={error} />
  <div class="o-grid-2">
    <form method="post" class="o-card o-form">
      <div class="o-card-head"><h2>Company & invoices</h2></div>
      <input type="hidden" name="action" value="company" />
      <label class="o-field"><span>Company name</span><input name="companyName" value={s.companyName} required /></label>
      <label class="o-field"><span>Line under the name</span><input name="companyTagline" value={s.companyTagline} /></label>
      <label class="o-field"><span>Address</span><textarea name="address" rows="2">{s.address}</textarea><span class="o-help">Printed at the foot of every invoice.</span></label>
      <div class="o-row">
        <label class="o-field"><span>Phone</span><input name="phone" value={s.phone} /></label>
        <label class="o-field"><span>Email</span><input name="email" value={s.email} /></label>
      </div>
      <label class="o-field"><span>Website</span><input name="website" value={s.website} /><span class="o-help">Not printed on invoices or statements.</span></label>
      <label class="o-field"><span>Payment instructions (printed under the totals)</span><textarea name="paymentInstructions" rows="3">{s.paymentInstructions}</textarea></label>
      <label class="o-field"><span>Invoice footer</span><input name="invoiceFooter" value={s.invoiceFooter} /></label>
      <div class="o-row">
        <label class="o-field"><span>Invoice prefix</span><input name="invoicePrefix" value={s.invoicePrefix} maxlength="8" /><span class="o-help">e.g. INV → INV-2026-0001</span></label>
        <label class="o-field"><span>Shipment prefix</span><input name="shipmentPrefix" value={s.shipmentPrefix} maxlength="8" /><span class="o-help">e.g. AML → AML-2026-0001</span></label>
        <label class="o-field"><span>Days to pay</span><input name="dueDays" type="number" min="0" max="365" value={s.dueDays} /></label>
      </div>
      <div><button class="o-btn primary" type="submit">Save settings</button></div>
    </form>

    <form method="post" class="o-card o-form">
      <div class="o-card-head"><h2>Exchange rates</h2></div>
      <input type="hidden" name="action" value="rates" />
      <p class="o-help" style="margin:0">How many of each currency make <strong>one US dollar</strong>. New entries start with these rates; each one keeps the rate it was saved with, so changing a rate here never changes old records.</p>
      <div class="o-table-wrap">
        <table class="o-table">
          <thead><tr><th>Currency</th><th class="num">Per 1 USD</th></tr></thead>
          <tbody>
            {currencies.map((c) => (
              <tr>
                <td><strong>{c.code}</strong> <span class="muted small">{c.name}</span></td>
                <td class="num">{c.code === 'USD' ? '1' : <input class="o-input" style="max-width:150px;text-align:right" name={`rate_${c.code}`} value={String(c.per_usd)} inputmode="decimal" />}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="o-row">
        <label class="o-field"><span>Add currency code</span><input name="new_code" maxlength="3" placeholder="e.g. EUR" /></label>
        <label class="o-field"><span>Name</span><input name="new_name" placeholder="Euro" /></label>
        <label class="o-field"><span>Per 1 USD</span><input name="new_rate" inputmode="decimal" placeholder="0.92" /></label>
      </div>
      <div><button class="o-btn primary" type="submit">Save rates</button></div>
    </form>
  </div>
  <div class="o-grid-2" style="margin-top:16px" id="backups">
    <form method="post" class="o-card o-form">
      <div class="o-card-head"><h2>Backups &amp; reminders</h2></div>
      <input type="hidden" name="action" value="backup_settings" />
      <p class="o-help" style="margin:0">
        Every few days the whole office is sent out as an Excel file, so the records are never only in one place. Each email also carries a restore file: Import → “Import everything at once” rebuilds the office from it.
      </p>
      <label class="o-field">
        <span>Email the backup to (one per line)</span>
        <textarea name="backupEmails" rows="3" placeholder="info@amanatlogistics.com">{s.backupEmails.join('\n')}</textarea>
      </label>
      <label class="o-field">
        <span>WhatsApp the Excel file to (one number per line)</span>
        <textarea name="backupWhatsapp" rows="3" placeholder="+93 70 000 0000">{s.backupWhatsapp.map(showPhone).join('\n')}</textarea>
        <span class="o-help">With the country code, e.g. +93 70 280 0277.</span>
      </label>
      <label class="o-field">
        <span>WhatsApp the list of clients who still owe us to</span>
        <input name="reminderWhatsapp" value={s.reminderWhatsapp ? showPhone(s.reminderWhatsapp) : ''} placeholder="+93 70 000 0000" />
        <span class="o-help">Who owes how much, sent with every backup. Leave empty to send no reminder.</span>
      </label>
      <label class="o-field" style="max-width:220px">
        <span>Send every … days</span>
        <input name="backupEveryDays" type="number" min="1" max="30" value={s.backupEveryDays} />
      </label>
      <div><button class="o-btn primary" type="submit">Save</button></div>
    </form>

    <div class="o-card">
      <div class="o-card-head"><h2>Backup status</h2></div>
      <dl class="o-kv">
        <dt>Email</dt>
        <dd>{ch.email ? <span class="pos">Ready</span> : <span class="neg">Not set up — the website's email key (RESEND_API_KEY) is missing on Vercel</span>}</dd>
        <dt>WhatsApp</dt>
        <dd>{ch.whatsapp ? <span class="pos">Connected</span> : <span class="neg">Not connected yet — see “Connect WhatsApp” below</span>}</dd>
        <dt>Every {s.backupEveryDays} days</dt>
        <dd><span class="pos">On</span></dd>
        <dt>Last sent</dt>
        <dd>{bs.lastSentAt ? when(bs.lastSentAt) : <span class="muted">Never</span>}</dd>
        <dt>Next</dt>
        <dd>{due && due.getTime() > Date.now() ? fmtDate(due.toISOString().slice(0, 10)) : 'At the next daily check (about 6:45 in the morning, Kabul time)'}</dd>
      </dl>
      {
        bs.last && (
          <div style="margin-top:12px">
            <div class="small muted">Last attempt, {when(bs.last.at)} ({bs.last.trigger === 'manual' ? 'sent by hand' : 'scheduled'}):</div>
            <ul class="small" style="margin:6px 0 0;padding-left:18px">
              {bs.last.email.map((r) => <li class:list={[!r.ok && 'neg']}>Email {result(r)}</li>)}
              {bs.last.whatsapp.map((r) => <li class:list={[!r.ok && 'neg']}>WhatsApp {result(r, true)}</li>)}
              {bs.last.reminder && <li class:list={[!bs.last.reminder.ok && 'neg']}>Reminder {result(bs.last.reminder, true)}</li>}
              {bs.last.notes.map((n) => <li class="muted">{n}</li>)}
            </ul>
          </div>
        )
      }
      <div class="o-actions" style="margin-top:14px">
        <form method="post" onsubmit="this.querySelector('button').disabled=true">
          <input type="hidden" name="action" value="backup_now" />
          <button class="o-btn primary" type="submit">Send backup now</button>
        </form>
        <a class="o-btn" href="/office/settings?download=xlsx" data-astro-prefetch="false">Download Excel</a>
        <a class="o-btn" href="/office/settings?download=restore" data-astro-prefetch="false">Download restore file</a>
      </div>
    </div>
  </div>
  <div class="o-grid-2" style="margin-top:16px" id="whatsapp">
    <form method="post" class="o-card o-form" autocomplete="off">
      <div class="o-card-head"><h2>Connect WhatsApp</h2>{ch.whatsapp && <span class="o-badge paid">Connected</span>}</div>
      <input type="hidden" name="action" value="whatsapp" />
      <p class="o-help" style="margin:0">Paste the two codes from Meta (steps on the right). They are checked with WhatsApp before they are saved.</p>
      <label class="o-field">
        <span>Phone number ID</span>
        <input name="phoneId" value={ch.wa.phoneId} inputmode="numeric" placeholder="e.g. 106540352242922" />
      </label>
      <label class="o-field">
        <span>Permanent access token</span>
        <input name="token" type="password" value="" placeholder={ch.wa.token ? 'Saved — leave empty to keep it' : 'EAAG…'} />
        <span class="o-help">Kept in the office database only; never shown again, and never part of a backup.</span>
      </label>
      <details>
        <summary class="small muted" style="cursor:pointer">Template names and language (only if you named them differently)</summary>
        <div class="o-row" style="margin-top:8px">
          <label class="o-field"><span>Backup template</span><input name="backupTemplate" value={ch.wa.backupTemplate} /></label>
          <label class="o-field"><span>Reminder template</span><input name="reminderTemplate" value={ch.wa.reminderTemplate} /></label>
          <label class="o-field" style="max-width:120px"><span>Language</span><input name="lang" value={ch.wa.lang} /></label>
        </div>
      </details>
      <div class="o-actions">
        <button class="o-btn primary" type="submit">{ch.whatsapp ? 'Save changes' : 'Connect WhatsApp'}</button>
      </div>
    </form>

    <div class="o-card">
      <div class="o-card-head"><h2>How to get the codes (about 20 minutes, once)</h2></div>
      <ol class="small" style="margin:0;padding-left:18px;display:grid;gap:8px">
        <li>Go to <strong>business.facebook.com</strong> and sign in with Facebook. Create a business account for Amanat Logistics if there is none.</li>
        <li>Go to <strong>developers.facebook.com</strong> → My Apps → <strong>Create app</strong> → choose <strong>Business</strong>, then add the <strong>WhatsApp</strong> product.</li>
        <li>In WhatsApp → <strong>API Setup</strong>, add the phone number that will <em>send</em> the messages. It must be a number that is <strong>not</strong> used in the WhatsApp app and is not one of the numbers you send to — a new SIM works. Copy its <strong>Phone number ID</strong>.</li>
        <li>In Business settings → Users → <strong>System users</strong>, add a system user (Admin), give it the app with full control, then <strong>Generate new token</strong> with <em>whatsapp_business_messaging</em> and <em>whatsapp_business_management</em>, set to never expire. Copy the token.</li>
        <li>In <strong>WhatsApp Manager</strong> → Message templates, create these two, both category <strong>Utility</strong>, language <strong>English</strong>:
          <div style="margin-top:6px"><code>office_backup</code> — Header: <strong>Document</strong>. Body:<br /><span class="muted">Amanat Office backup for &#123;&#123;1&#125;&#125;: &#123;&#123;2&#125;&#125;. The Excel file has every shipment, invoice, payment and expense.</span></div>
          <div style="margin-top:6px"><code>unpaid_reminder</code> — Body:<br /><span class="muted">Payment reminder: &#123;&#123;1&#125;&#125; clients still owe Amanat Logistics &#123;&#123;2&#125;&#125; in total. &#123;&#123;3&#125;&#125;. The full list is in the latest backup.</span></div>
        </li>
        <li>Paste the Phone number ID and the token on the left and press <strong>Connect WhatsApp</strong>. When Meta has approved the templates (minutes to a day), press <strong>Send backup now</strong> above to test.</li>
      </ol>
      {
        ch.whatsapp && (
          <form method="post" style="margin-top:14px" onsubmit="return confirm('Disconnect WhatsApp? The access token is deleted from the office.')">
            <input type="hidden" name="action" value="whatsapp_forget" />
            <button class="o-btn danger sm" type="submit">Disconnect WhatsApp</button>
          </form>
        )
      }
    </div>
  </div>
</OfficeLayout>

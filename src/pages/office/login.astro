---
/**
 * Amanat Office sign-in. Not linked from navigation except the small
 * "Staff login" link in the website footer; never indexed.
 */
import '../../styles/office.css';
import { currentUser, login, sessionCookie, safeNext, sameOrigin, setupProblem, ownerUsername } from '../../lib/office/auth';
import { q } from '../../lib/office/db';

export const prerender = false;

const next = safeNext(Astro.url.searchParams.get('next'));
let error: string | null = setupProblem();
let username = '';

if (!error && (await currentUser(Astro.request))) return Astro.redirect(next);

if (!error && Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) {
    error = 'That request looked unsafe, so it was blocked.';
  } else {
    const fd = await Astro.request.formData();
    username = String(fd.get('username') ?? '');
    const res = await login(username, String(fd.get('password') ?? ''));
    if (res.ok) {
      return new Response(null, { status: 303, headers: { Location: next, 'Set-Cookie': sessionCookie(res.user) } });
    }
    error = res.error;
  }
}

let firstRun = false;
if (!setupProblem()) {
  try {
    firstRun = ((await q<{ n: number }>('SELECT COUNT(*) AS n FROM office_users'))[0]?.n ?? 0) === 0;
  } catch (e) {
    console.error('Office DB error:', e);
    error = 'Could not reach the office database. Check DATABASE_URL.';
  }
}
Astro.response.headers.set('Cache-Control', 'no-store');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in — Amanat Office</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Semi+Condensed:wght@600;700&display=swap" rel="stylesheet" />
    <style>
      .login-wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: var(--o-maroon-ink); }
      .login-card { width: 100%; max-width: 400px; background: #fff; border-radius: 14px; padding: 30px 28px; box-shadow: 0 30px 80px rgba(0,0,0,.35); }
      .login-card img { width: 86px; height: auto; display: block; margin: 0 auto 10px; }
      .login-card h1 { text-align: center; font-size: 26px; }
      .login-card p.lead { text-align: center; color: var(--o-muted); margin: 4px 0 20px; }
      .login-card .o-btn { width: 100%; padding: 12px; font-size: 15.5px; }
    </style>
  </head>
  <body class="o-body">
    <main class="login-wrap">
      <form method="post" class="login-card o-form" autocomplete="on">
        <img src="/images/brand-logo-maroon.png" alt="Amanat Logistics" width="86" height="82" />
        <div>
          <h1>Amanat Office</h1>
          <p class="lead">Staff only. Sign in with your own account.</p>
        </div>
        {error && <div class="o-flash err" role="alert">{error}</div>}
        {
          firstRun && !error && (
            <div class="o-flash ok">
              First sign-in: use the username <strong>{ownerUsername()}</strong> and the owner password set for this website. That creates the owner account; add everyone else from the Users page.
            </div>
          )
        }
        <label class="o-field">
          <span>Username</span>
          <input name="username" autocomplete="username" required value={username} autocapitalize="none" spellcheck="false" />
        </label>
        <label class="o-field">
          <span>Password</span>
          <input name="password" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit" class="o-btn primary">Sign in</button>
        <a href="/" class="small" style="text-align:center">← Back to the website</a>
      </form>
    </main>
  </body>
</html>

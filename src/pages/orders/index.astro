---
/**
 * Orders — the customer-facing lookup. Direct link only: it is in no menu, is
 * marked noindex, and is blocked in robots.txt.
 *
 * Deliberately the same page as /tracking with a different source of data. The
 * header, card, search form, details panel and timeline are the tracker's own,
 * so the two sections cannot drift apart; only the backend differs, and orders
 * come from Google Sheets rather than Postgres.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ShipmentDetails from '../../components/tracker/ShipmentDetails.astro';
import TrackingTimeline from '../../components/tracker/TrackingTimeline.astro';
import { findOrder, isConfigured, type SheetOrder } from '../../lib/orders/api';
import { toShipment, toSteps } from '../../lib/orders/model';

export const prerender = false;

const code = (Astro.url.searchParams.get('code') ?? '').trim();
const searched = code !== '';

let order: SheetOrder | null = null;
let lookupFailed = false;

if (searched && isConfigured()) {
  try {
    order = await findOrder(code);
  } catch (e) {
    console.error('Order lookup failed:', e);
    lookupFailed = true;
  }
}

const shipment = order ? toShipment(order) : null;
const steps = order ? toSteps(order) : [];
---

<BaseLayout
  title="Order Lookup"
  description="Look up an Amanat Logistics order by invoice number or tracking number."
  noindex
>
  <!-- ============ PAGE HEADER ============ -->
  <section class="bg-plum">
    <div class="mx-auto flex max-w-[1240px] flex-col items-start gap-5 px-5 py-16 md:px-10 md:pb-[76px] md:pt-[84px]">
      <Eyebrow text="Order Lookup" tone="dark" />
      <h1 class="m-0 font-serif text-[38px] font-bold leading-[1.12] text-[#F8F3E9] md:text-[52px]">
        Track Your Order
      </h1>
      <p class="m-0 max-w-[62ch] text-[17px] leading-relaxed text-[#D9C8BE] md:text-[18px]">
        Enter your invoice number or tracking number to see your order details and follow its
        progress from our Kandahar warehouse right through to delivery.
      </p>
    </div>
  </section>

  <!-- ============ LOOKUP CARD ============ -->
  <section class="bg-cream">
    <div class="mx-auto max-w-[1240px] px-5 py-16 md:px-10 md:py-20">
      <div class="rounded-2xl border border-line bg-paper p-6 shadow-[0_10px_30px_rgba(42,26,18,0.06)] md:p-10">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
          <h2 class="m-0 flex items-center gap-2.5 font-serif text-[22px] font-bold text-plum md:text-[26px]">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="flex-none" aria-hidden="true">
              <path
                d="M12 21s7-5.7 7-11a7 7 0 1 0-14 0c0 5.3 7 11 7 11Z"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"></path>
              <circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.7"></circle>
            </svg>
            Find Your Order
          </h2>
        </div>

        <!-- Search: GET, so a result is shareable and bookmarkable. -->
        <form method="get" action="/orders" class="flex flex-col gap-3 sm:flex-row">
          <label for="code" class="sr-only">Invoice or tracking number</label>
          <input
            id="code"
            name="code"
            type="text"
            required
            value={code}
            placeholder="e.g. RN-062 or AM-0031-INV-062"
            class="amn-field flex-1 rounded-lg border border-line bg-cream px-4 py-3.5 text-[15px] text-ink placeholder:text-muted/70"
          />
          <button
            type="submit"
            class="flex items-center justify-center gap-2 rounded-lg bg-accent px-7 py-3.5 text-[15px] font-semibold text-paper transition-colors hover:bg-plum-hover"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" class="flex-none" aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.2"></circle>
              <path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
            </svg>
            Track Order
          </button>
        </form>

        <!-- Results -->
        {
          !isConfigured() && searched && (
            <p class="mt-7 rounded-lg border border-[#E8C9A8] bg-[#FBF0E2] px-4 py-3.5 text-[14.5px] text-[#8C5A2B]">
              Order lookup is temporarily unavailable. Please try again shortly.
            </p>
          )
        }

        {
          lookupFailed && (
            <p class="mt-7 rounded-lg border border-[#E8C9A8] bg-[#FBF0E2] px-4 py-3.5 text-[14.5px] text-[#8C5A2B]">
              We could not reach our order records just now. Please try again shortly.
            </p>
          )
        }

        {
          searched && !order && isConfigured() && !lookupFailed && (
            <div class="mt-7 flex items-start gap-3 rounded-lg border border-[#EBC3BD] bg-[#FBEEEC] px-4 py-3.5 text-[14.5px] text-[#9A3226]">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" class="mt-px flex-none" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
                <path d="M12 7.5v5.5M12 16.2v.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span>
                No order found for "<bdi>{code}</bdi>". Please check the number and try again.
              </span>
            </div>
          )
        }

        {
          order && shipment && (
            <Fragment>
              <div class="mt-8 grid grid-cols-1 items-start gap-6 lg:grid-cols-[340px_1fr]">
                <ShipmentDetails
                  shipment={shipment}
                  lang="en"
                  shippingMethod={shipment.shipping_method}
                />
                <TrackingTimeline steps={steps} currentStep={shipment.current_step} lang="en" />
              </div>

              {/* The one thing a shipment does not carry: what was ordered. */}
              {(order.product || order.notes) && (
                <div class="mt-6 rounded-xl border border-line bg-paper p-6 md:p-7">
                  <h2 class="m-0 mb-5 flex items-center gap-2.5 font-serif text-[19px] font-bold text-plum">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" class="flex-none" aria-hidden="true">
                      <path
                        d="M3 8.5 12 4l9 4.5v7L12 20l-9-4.5v-7Z"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linejoin="round"
                      />
                      <path d="m3 8.5 9 4.5 9-4.5M12 13v7" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                    </svg>
                    Order Contents
                  </h2>
                  <dl class="m-0">
                    {order.product && (
                      <div class="flex items-start justify-between gap-4 border-b border-line py-3">
                        <dt class="text-[14px] text-muted">Product</dt>
                        <dd class="m-0 text-end text-[14px] font-semibold text-ink">{order.product}</dd>
                      </div>
                    )}
                    {order.quantity && (
                      <div class="flex items-start justify-between gap-4 border-b border-line py-3">
                        <dt class="text-[14px] text-muted">Quantity</dt>
                        <dd class="m-0 text-end text-[14px] font-semibold text-ink">{order.quantity}</dd>
                      </div>
                    )}
                    {order.notes && (
                      <div class="flex items-start justify-between gap-4 py-3">
                        <dt class="text-[14px] text-muted">Notes</dt>
                        <dd class="m-0 text-end text-[14px] font-semibold text-ink">{order.notes}</dd>
                      </div>
                    )}
                  </dl>
                </div>
              )}
            </Fragment>
          )
        }

        {
          !searched && (
            <div class="mt-8 flex flex-col items-center gap-3 rounded-xl border border-dashed border-line bg-cream px-6 py-14 text-center">
              <svg width="46" height="46" viewBox="0 0 24 24" fill="none" class="text-label" aria-hidden="true">
                <path
                  d="M3 8.5 12 4l9 4.5v7L12 20l-9-4.5v-7Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
                <path d="m3 8.5 9 4.5 9-4.5M12 13v7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              </svg>
              <p class="m-0 max-w-[46ch] text-[15px] leading-relaxed text-muted">
                Your invoice number is on the paperwork we sent you. Enter it above to see where your
                order has reached.
              </p>
            </div>
          )
        }
      </div>

      <p class="mt-6 text-center text-[14px] text-muted">
        Can't find your order?{' '}
        <a
          href="/contact#form"
          class="font-semibold text-accent-deep underline underline-offset-2 hover:text-plum"
        >
          Contact our team
        </a>{' '}
        and we'll look it up for you.
      </p>
    </div>
  </section>
</BaseLayout>

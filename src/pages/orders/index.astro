---
/**
 * The order lookup moved into the tracking section, at /tracking/orders.
 *
 * This route stays so nothing already sent to a customer breaks: any link,
 * bookmark or WhatsApp message pointing at /orders still opens the lookup,
 * carrying its ?code= and ?lang= straight through.
 *
 * 307 rather than 301: the move is deliberate, but a permanent redirect is
 * cached by the browser for good, and this is not worth being unable to undo.
 */
export const prerender = false;

const target = new URL(Astro.url);
target.pathname = '/tracking/orders';
return Astro.redirect(`${target.pathname}${target.search}`, 307);
---

---
/**
 * Edit one shipment — writes straight back to the SHIPMENTS sheet.
 *
 * Only the columns the website tracks are offered. Everything else in the
 * workbook (S.No, trip IDs, the formula columns, Remarks) is left untouched:
 * the Apps Script writes the row back with those cells exactly as it read them.
 */
import TrackerAdminLayout from '../../../layouts/TrackerAdminLayout.astro';
import TrackerAdminLogin from '../../../layouts/TrackerAdminLogin.astro';
import { isOrdersAdmin } from '../../../lib/orders/auth';
import { isSameOrigin } from '../../../lib/session';
import {
  findOrderById,
  isConfigured,
  SHEETS_NOT_CONFIGURED,
  updateOrder,
  type SheetOrder,
} from '../../../lib/orders/api';
import { ORDER_STAGES, ORDER_STAGE_COUNT, stageTitle } from '../../../lib/orders/model';

export const prerender = false;

const authed = await isOrdersAdmin(Astro.request);
const id = decodeURIComponent(Astro.params.id ?? '');

let order: SheetOrder | null = null;
let trackingColumn = true;
let error: string | null = null;

/** Plain text columns the form offers. */
const TEXT_FIELDS = [
  'invoice_number', 'tracking_number', 'commodity', 'cartons', 'gross_weight',
  'kdr_plate', 'tas_plate', 'awb_no', 'flight_no',
] as const;
/** Date columns, kept to what <input type="date"> produces. */
const DATE_FIELDS = ['invoice_date', 'flight_date'] as const;

const asDate = (value: string) => (/^\d{4}-\d{2}-\d{2}$/.test(value) ? value : '');

if (authed) {
  if (!isConfigured()) {
    error = SHEETS_NOT_CONFIGURED;
  } else if (!id) {
    return Astro.redirect('/orders/admin', 303);
  } else {
    try {
      const found = await findOrderById(id);
      order = found.order;
      trackingColumn = found.trackingColumn;
    } catch (e) {
      console.error('Loading shipment failed:', e);
      error = 'Could not read the Google Sheet. Please try again.';
    }
    if (!order && !error) return Astro.redirect('/orders/admin', 303);

    if (order && Astro.request.method === 'POST') {
      if (!isSameOrigin(Astro.request)) {
        error = 'That request looked unsafe, so it was blocked. Please try again.';
      } else {
        const form = await Astro.request.formData();
        const fields: Record<string, string> = {};
        for (const field of TEXT_FIELDS) fields[field] = String(form.get(field) ?? '').trim();
        for (const field of DATE_FIELDS) fields[field] = asDate(String(form.get(field) ?? '').trim());
        for (let n = 1; n <= ORDER_STAGE_COUNT; n++) {
          fields[`stage_date_${n}`] = asDate(String(form.get(`stage_date_${n}`) ?? '').trim());
        }

        if (!fields.invoice_number) {
          error = 'An ACCI invoice number is required — it is what the tracking number is built from.';
        } else if (fields.tracking_number && !/^[A-Za-z0-9][A-Za-z0-9 \-\/]*$/.test(fields.tracking_number)) {
          error = 'A tracking number can contain letters, digits, spaces, hyphens and slashes.';
        } else {
          try {
            await updateOrder(id, fields);
            return Astro.redirect('/orders/admin?saved=1', 303);
          } catch (e) {
            console.error('Saving shipment failed:', e);
            error = 'Could not write to the Google Sheet. Please try again.';
          }
        }
        // Keep what was typed so an error never empties the form.
        order = {
          ...order,
          ...fields,
          stage_dates: Array.from({ length: ORDER_STAGE_COUNT }, (_, i) => fields[`stage_date_${i + 1}`]),
        } as SheetOrder;
      }
    }
  }
}
---

{
  !authed ? (
    <TrackerAdminLogin>
      <div class="login-box">
        <h1>Session expired</h1>
        <p class="lede">Please log in again to edit this shipment.</p>
        <a class="btn btn-primary" href="/orders/admin" style="width:100%;justify-content:center;">
          Go to login
        </a>
      </div>
    </TrackerAdminLogin>
  ) : (
    <TrackerAdminLayout title="Edit shipment">
      <div class="page-head">
        <h1>{order ? `Edit — ${order.invoice_number}` : 'Edit shipment'}</h1>
        <a class="btn btn-soft" href="/orders/admin">← Back to shipments</a>
      </div>

      <div class="card">
        {!order ? (
          <div class="alert alert-err">{error ?? 'Shipment not found.'}</div>
        ) : (
          <form method="post">
            {error && <div class="alert alert-err">{error}</div>}

            <div class="section-title">
              Shipment details
              <span class="note">
                Saved to row {order.row} of the SHIPMENTS sheet. Columns this page does not show —
                trip IDs, the status formulas, remarks — are written back untouched.
              </span>
            </div>

            <div class="form-grid">
              <div class="field">
                <label for="invoice_number">ACCI invoice no *</label>
                <input id="invoice_number" name="invoice_number" value={order.invoice_number} required />
              </div>
              <div class="field">
                <label for="tracking_number">Tracking number</label>
                <input
                  id="tracking_number"
                  name={trackingColumn ? 'tracking_number' : undefined}
                  value={order.tracking_number}
                  readonly={!trackingColumn}
                />
                <span class="hint">
                  {trackingColumn
                    ? 'Issued by the tracker as AM-<sequence>-INV-<invoice number>. Change it here if you need to — what you type is kept, and customers can look the shipment up by it. Clear it to hand the number back to the tracker.'
                    : 'Issued by the tracker as AM-<sequence>-INV-<invoice number> and held in the backend, so the sheet carries no tracking column. To pin or correct one, ask for it to be set in the tracker’s register.'}
                </span>
              </div>
              <div class="field">
                <label for="invoice_date">ACCI invoice date (booked)</label>
                <input id="invoice_date" name="invoice_date" type="date" value={order.invoice_date} />
              </div>
              <div class="field">
                <label for="commodity">Commodity</label>
                <input id="commodity" name="commodity" value={order.commodity} />
              </div>
              <div class="field">
                <label for="cartons">Cartons / pkgs</label>
                <input id="cartons" name="cartons" value={order.cartons} inputmode="numeric" />
              </div>
              <div class="field">
                <label for="gross_weight">Gross weight (kg)</label>
                <input id="gross_weight" name="gross_weight" value={order.gross_weight} inputmode="decimal" />
              </div>
              <div class="field">
                <label for="kdr_plate">KDR truck plate</label>
                <input id="kdr_plate" name="kdr_plate" value={order.kdr_plate} />
              </div>
              <div class="field">
                <label for="tas_plate">TAS truck plate</label>
                <input id="tas_plate" name="tas_plate" value={order.tas_plate} />
              </div>
              <div class="field">
                <label for="awb_no">AWB no</label>
                <input id="awb_no" name="awb_no" value={order.awb_no} />
              </div>
              <div class="field">
                <label for="flight_no">Flight no</label>
                <input id="flight_no" name="flight_no" value={order.flight_no} />
              </div>
              <div class="field">
                <label for="flight_date">Flight date</label>
                <input id="flight_date" name="flight_date" type="date" value={order.flight_date} />
              </div>
              <div class="field">
                <label>Current stage</label>
                <input value={order.stage >= 1 ? `${order.stage}. ${stageTitle(order)}` : stageTitle(order)} readonly />
                <span class="hint">
                  Worked out from the dates below — the highest stage with a date. Fill a date in to
                  move the shipment on.
                </span>
              </div>
            </div>

            <div class="section-title">
              The fourteen stages
              <span class="note">
                Kandahar → Hairatan → Termez → Tashkent → Delhi. Leave a stage blank and the
                customer sees it as “Pending”. Route KDR skips stage 7; route HRTN skips stages 1
                and 2 — leaving those blank is correct, not missing data.
              </span>
            </div>

            <div class="steps-grid">
              {ORDER_STAGES.map((stage, i) => (
                <div class="step-card">
                  <h4>Stage {stage.n}</h4>
                  <div class="field">
                    <label for={`stage_date_${stage.n}`}>{stage.title}</label>
                    <input
                      id={`stage_date_${stage.n}`}
                      name={`stage_date_${stage.n}`}
                      type="date"
                      value={order.stage_dates[i] ?? ''}
                    />
                  </div>
                </div>
              ))}
            </div>

            <div class="form-actions">
              <button class="btn btn-primary" type="submit">Save to sheet</button>
              <a class="btn btn-soft" href="/orders/admin">Cancel</a>
            </div>
          </form>
        )}
      </div>
    </TrackerAdminLayout>
  )
}

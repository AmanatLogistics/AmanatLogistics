---
/**
 * The shipment edit page moved to /tracking/orders/admin/<id>.
 *
 * 307 preserves the method, so a form posted from a copy of the old page that
 * is still open in a tab is carried to the new route rather than silently
 * turning into a GET and losing the edit.
 */
export const prerender = false;

const id = Astro.params.id ?? '';
const target = new URL(Astro.url);
target.pathname = `/tracking/orders/admin/${id}`;
return Astro.redirect(`${target.pathname}${target.search}`, 307);
---

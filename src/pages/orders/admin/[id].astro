---
/**
 * Edit one order — writes straight back to the Google Sheet.
 *
 * Uses the tracker admin's layout, stylesheet and form furniture, so it reads
 * as the same panel. Fields the sheet has no column for are simply ignored by
 * the Apps Script, so a trimmed-down sheet still saves cleanly.
 */
import TrackerAdminLayout from '../../../layouts/TrackerAdminLayout.astro';
import TrackerAdminLogin from '../../../layouts/TrackerAdminLogin.astro';
import { isOrdersAdmin } from '../../../lib/orders/auth';
import { isSameOrigin } from '../../../lib/session';
import {
  findOrderById,
  isConfigured,
  SHEETS_NOT_CONFIGURED,
  updateOrder,
  type SheetOrder,
} from '../../../lib/orders/api';
import { stageTitle } from '../../../lib/orders/model';
import { DEFAULT_STEPS, STEP_COUNT } from '../../../lib/tracker/shipments';

export const prerender = false;

const authed = await isOrdersAdmin(Astro.request);
const id = decodeURIComponent(Astro.params.id ?? '');

let order: SheetOrder | null = null;
let error: string | null = null;

/** Only what the form offers; the Apps Script ignores anything else. */
const FIELDS = [
  'invoice_number', 'customer_name', 'phone', 'whatsapp_number', 'product',
  'quantity', 'weight', 'origin', 'destination', 'shipping_method',
  'order_date', 'estimated_delivery', 'actual_delivery', 'notes',
] as const;

const asDate = (value: string) => (/^\d{4}-\d{2}-\d{2}$/.test(value) ? value : '');

if (authed) {
  if (!isConfigured()) {
    error = SHEETS_NOT_CONFIGURED;
  } else if (!id) {
    return Astro.redirect('/orders/admin', 303);
  } else {
    try {
      order = await findOrderById(id);
    } catch (e) {
      console.error('Loading order failed:', e);
      error = 'Could not read the Google Sheet. Please try again.';
    }
    if (!order && !error) return Astro.redirect('/orders/admin', 303);

    if (order && Astro.request.method === 'POST') {
      if (!isSameOrigin(Astro.request)) {
        error = 'That request looked unsafe, so it was blocked. Please try again.';
      } else {
        const form = await Astro.request.formData();
        const fields: Record<string, string> = {};
        for (const field of FIELDS) {
          const raw = String(form.get(field) ?? '').trim();
          fields[field] = field.endsWith('_date') || field.endsWith('_delivery') ? asDate(raw) : raw;
        }

        const stage = Number.parseInt(String(form.get('stage') ?? ''), 10);
        fields.stage = String(Number.isFinite(stage) && stage >= 1 && stage <= STEP_COUNT ? stage : 1);
        fields.status = DEFAULT_STEPS[Number(fields.stage) - 1]?.step_title ?? '';

        // Per-stage dates, saved only where the sheet has those columns.
        for (let n = 1; n <= STEP_COUNT; n++) {
          fields[`stage_date_${n}`] = asDate(String(form.get(`stage_date_${n}`) ?? '').trim());
        }

        if (!fields.invoice_number) {
          error = 'An invoice number is required — it is what the tracking number is built from.';
          order = { ...order, ...fields, stage: Number(fields.stage) } as SheetOrder;
        } else {
          try {
            await updateOrder(id, fields);
            return Astro.redirect('/orders/admin?saved=1', 303);
          } catch (e) {
            console.error('Saving order failed:', e);
            error = 'Could not write to the Google Sheet. Please try again.';
            order = { ...order, ...fields, stage: Number(fields.stage) } as SheetOrder;
          }
        }
      }
    }
  }
}
---

{
  !authed ? (
    <TrackerAdminLogin>
      <div class="login-box">
        <h1>Session expired</h1>
        <p class="lede">Please log in again to edit this order.</p>
        <a class="btn btn-primary" href="/orders/admin" style="width:100%;justify-content:center;">
          Go to login
        </a>
      </div>
    </TrackerAdminLogin>
  ) : (
    <TrackerAdminLayout title="Edit order">
      <div class="page-head">
        <h1>{order ? `Edit — ${order.invoice_number || order.tracking_number}` : 'Edit order'}</h1>
        <a class="btn btn-soft" href="/orders/admin">← Back to orders</a>
      </div>

      <div class="card">
        {!order ? (
          <div class="alert alert-err">{error ?? 'Order not found.'}</div>
        ) : (
          <form method="post">
            {error && <div class="alert alert-err">{error}</div>}

            <div class="section-title">
              Order details
              <span class="note">
                Saved straight to row {order.row} of the Google Sheet. The tracking number is
                derived from the invoice number and is not editable here.
              </span>
            </div>

            <div class="form-grid">
              <div class="field">
                <label for="invoice_number">Invoice number *</label>
                <input id="invoice_number" name="invoice_number" value={order.invoice_number} required />
              </div>
              <div class="field">
                <label for="tracking_number">Tracking number</label>
                <input id="tracking_number" value={order.tracking_number} readonly />
                <span class="hint">Generated from the invoice number by the Apps Script.</span>
              </div>
              <div class="field">
                <label for="customer_name">Customer name</label>
                <input id="customer_name" name="customer_name" value={order.customer_name} />
              </div>
              <div class="field">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" value={order.phone} />
              </div>
              <div class="field">
                <label for="whatsapp_number">WhatsApp number</label>
                <input id="whatsapp_number" name="whatsapp_number" value={order.whatsapp_number} placeholder="e.g. 923001234567" />
                <span class="hint">With country code, digits only. Leave blank to hide the button.</span>
              </div>
              <div class="field">
                <label for="product">Product</label>
                <input id="product" name="product" value={order.product} />
              </div>
              <div class="field">
                <label for="quantity">Quantity</label>
                <input id="quantity" name="quantity" value={order.quantity} />
              </div>
              <div class="field">
                <label for="weight">Total weight</label>
                <input id="weight" name="weight" value={order.weight} placeholder="e.g. 120.5 KG" />
              </div>
              <div class="field">
                <label for="origin">Origin</label>
                <input id="origin" name="origin" value={order.origin} />
              </div>
              <div class="field">
                <label for="destination">Destination</label>
                <input id="destination" name="destination" value={order.destination} />
              </div>
              <div class="field">
                <label for="shipping_method">Shipping method</label>
                <input id="shipping_method" name="shipping_method" value={order.shipping_method} />
              </div>
              <div class="field">
                <label for="stage">Current stage</label>
                <select id="stage" name="stage">
                  {DEFAULT_STEPS.map((step, i) => (
                    <option value={i + 1} selected={order.stage === i + 1}>
                      {i + 1}. {step.step_title}
                    </option>
                  ))}
                </select>
                <span class="hint">
                  Everything before this shows as completed; everything after, as pending. Currently
                  “{stageTitle(order)}”.
                </span>
              </div>
              <div class="field">
                <label for="order_date">Order date</label>
                <input id="order_date" name="order_date" type="date" value={order.order_date} />
              </div>
              <div class="field">
                <label for="estimated_delivery">Estimated delivery</label>
                <input id="estimated_delivery" name="estimated_delivery" type="date" value={order.estimated_delivery} />
              </div>
              <div class="field">
                <label for="actual_delivery">Actual delivery</label>
                <input id="actual_delivery" name="actual_delivery" type="date" value={order.actual_delivery} />
                <span class="hint">The “Received” button on the orders list fills this in with today's date.</span>
              </div>
              <div class="field">
                <label for="notes">Notes</label>
                <input id="notes" name="notes" value={order.notes} />
              </div>
            </div>

            <div class="section-title">
              Progress timeline
              <span class="note">
                Optional. These save only if the sheet has “Stage 1 Date” … “Stage {STEP_COUNT} Date”
                columns; without them the customer still sees the stage the order has reached.
              </span>
            </div>

            <div class="steps-grid">
              {DEFAULT_STEPS.map((step, i) => (
                <div class="step-card">
                  <h4>Step {i + 1}</h4>
                  <div class="field">
                    <label for={`stage_date_${i + 1}`}>{step.step_title}</label>
                    <input
                      id={`stage_date_${i + 1}`}
                      name={`stage_date_${i + 1}`}
                      type="date"
                      value={order.stage_dates[i] ?? ''}
                    />
                  </div>
                </div>
              ))}
            </div>

            <div class="form-actions">
              <button class="btn btn-primary" type="submit">Save to sheet</button>
              <a class="btn btn-soft" href="/orders/admin">Cancel</a>
            </div>
          </form>
        )}
      </div>
    </TrackerAdminLayout>
  )
}

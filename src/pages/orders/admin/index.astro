---
/**
 * Orders admin — the SHIPMENTS sheet, in the tracker's own panel.
 *
 * Structurally the same page as /tracking/admin: same layout, stylesheet, stat
 * tiles, filter bar, table markup and client script. What differs is the data
 * and its shape — fourteen stages from Kandahar to Delhi, read from Google
 * Sheets rather than Postgres.
 *
 * Separate password (ORDERS_ADMIN_PASSWORD) and separate cookie, so a session
 * here is not a session for the website admin or the shipment tracker.
 */
import TrackerAdminLayout from '../../../layouts/TrackerAdminLayout.astro';
import TrackerAdminLogin from '../../../layouts/TrackerAdminLogin.astro';
import { SITE } from '../../../consts';
import { isOrdersAdmin, ordersPassword } from '../../../lib/orders/auth';
import {
  isConfigured,
  listOrders,
  REQUIRED_SCRIPT_VERSION,
  SHEETS_NOT_CONFIGURED,
  type SheetOrder,
} from '../../../lib/orders/api';
import {
  asGroup,
  countByGroup,
  formatCount,
  formatWeight,
  groupOf,
  GROUPS,
  GROUP_LABEL,
  GROUP_NOTE,
  GROUP_TONE,
  ORDER_STAGE_COUNT,
  searchText,
  stageDate,
  stageTitle,
  type Group,
} from '../../../lib/orders/model';
import { formatDate } from '../../../lib/tracker/shipments';

export const prerender = false;

const authed = await isOrdersAdmin(Astro.request);
const params = Astro.url.searchParams;

/* ---------- logged out ---------- */
const loginErrors: Record<string, string> = {
  '1': 'Wrong password.',
  origin: 'That request looked unsafe, so it was blocked. Please try again.',
  unconfigured: 'The orders admin password is not set. Add ORDERS_ADMIN_PASSWORD in your Vercel environment variables.',
};
const loginError = loginErrors[params.get('error') ?? ''] ?? '';

/* ---------- logged in ---------- */
const status = asGroup(params.get('status') ?? '');
const search = (params.get('q') ?? '').trim();

let orders: SheetOrder[] = [];
let scriptVersion = REQUIRED_SCRIPT_VERSION;
let loadError = '';

if (authed) {
  if (!isConfigured()) {
    loadError = SHEETS_NOT_CONFIGURED;
  } else {
    try {
      const result = await listOrders();
      orders = result.orders;
      scriptVersion = result.version;
    } catch (e) {
      console.error('SHIPMENTS sheet failed to load:', e);
      loadError = 'Could not read the Google Sheet. Check that the Apps Script web app is deployed and the token matches.';
    }
  }
}

const counts = countByGroup(orders);

const notice = params.has('saved')
  ? 'Shipment saved to the sheet.'
  : params.has('delivered')
    ? 'Marked delivered to Delhi.'
    : '';
const actionError = params.get('error') === 'receive'
  ? 'Could not update the sheet. Please try again.'
  : '';

const cssSafeSearch = search.toLowerCase().replace(/[^a-z0-9 @._-]/g, '').slice(0, 60);

const filterHref = (next: Group | '') => {
  const url = new URLSearchParams();
  if (search) url.set('q', search);
  if (next) url.set('status', next);
  const qs = url.toString();
  return qs ? `/orders/admin?${qs}` : '/orders/admin';
};

// The workbook's own seven groups, plus a total.
const tiles: { key: Group | ''; label: string; value: number; tone: string; note: string }[] = [
  { key: '', label: 'All shipments', value: counts.total, tone: 'all', note: 'Everything in the sheet' },
  ...GROUPS.map((g) => ({
    key: g,
    label: GROUP_LABEL[g],
    value: counts[g],
    tone: GROUP_TONE[g],
    note: GROUP_NOTE[g],
  })),
];
---

{
  !authed ? (
    <TrackerAdminLogin>
      <div class="login-box">
        <h1>Shipments</h1>
        <p class="lede">Sign in to view and update the shipment sheet.</p>

        {loginError && <div class="alert alert-err">{loginError}</div>}
        {!ordersPassword() && !loginError && (
          <div class="alert alert-err">
            No orders password is set yet. Add <code>ORDERS_ADMIN_PASSWORD</code> to your
            environment variables.
          </div>
        )}

        <form method="post" action="/api/orders/login">
          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required autofocus />
          </div>
          <button class="btn btn-primary" type="submit">Log in</button>
        </form>

        <a class="back" href="/">← Back to {SITE.name}</a>
      </div>
    </TrackerAdminLogin>
  ) : (
    <TrackerAdminLayout title="Shipments">
      {cssSafeSearch && (
        <style
          id="nojs-search"
          set:html={`[data-row]:not([data-search*="${cssSafeSearch}"]){display:none}`}
        />
      )}

      <div class="dash" data-noun="shipment" data-filter={status} data-load-error={loadError ? '1' : '0'}>
        <div class="page-head">
          <div>
            <h1>Shipments</h1>
            <p class="page-sub" data-summary data-default="Live from the Google Sheet — one row per ACCI invoice, Kandahar to Delhi.">
              Live from the Google Sheet — one row per ACCI invoice, Kandahar to Delhi.
            </p>
          </div>
          <div class="head-actions">
            <span class="synced" data-synced />
            {/* A real link, so it still re-reads the sheet with JavaScript off;
                the script intercepts it and swaps the rows in place instead. */}
            <a class="btn btn-soft" href="/orders/admin" data-refresh data-astro-prefetch="false">
              ↻ Refresh
            </a>
          </div>
        </div>

        <div class="alert alert-ok" data-notice hidden={!notice}>
          {notice}
        </div>
        {actionError && <div class="alert alert-err">{actionError}</div>}
        {loadError && <div class="alert alert-err">{loadError}</div>}

        {/* Apps Script serves the version last DEPLOYED, so an old one keeps
            answering until a new deployment is made. Saying so beats looking
            broken. */}
        {!loadError && scriptVersion < REQUIRED_SCRIPT_VERSION && (
          <div class="alert alert-err">
            <strong>The Apps Script in your sheet is out of date</strong> — it is version{' '}
            {scriptVersion || 'older than 3'}, this site needs {REQUIRED_SCRIPT_VERSION}. Tracking
            numbers and other fixes will not appear until you update it. In the sheet: <em>
            Extensions → Apps Script</em>, replace the file with the current{' '}
            <code>google-apps-script/orders-api.gs</code>, then <em>Deploy → Manage deployments →
            the pencil → Version: New version → Deploy</em>. Saving the file is not enough — it has
            to be deployed.
          </div>
        )}
        <div class="stat-grid stat-grid-wide">
          {tiles.map((tile) => (
            <a
              class={`stat stat-${tile.tone}${tile.key === status ? ' is-active' : ''}`}
              href={filterHref(tile.key)}
              data-tile={tile.key}
              data-astro-prefetch="false"
              aria-current={tile.key === status ? 'true' : undefined}
            >
              <span class="stat-label">{tile.label}</span>
              <span class="stat-value" data-count={tile.key || 'total'}>
                {tile.value}
              </span>
              <span class="stat-note">{tile.note}</span>
            </a>
          ))}
        </div>

        <div class="card">
          <form method="get" class="toolbar" data-toolbar>
            <div class="field field-search">
              <label for="q">Search</label>
              <div class="search-wrap">
                <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
                  <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                <input
                  id="q"
                  name="q"
                  type="search"
                  value={search}
                  autocomplete="off"
                  placeholder="Invoice #, tracking #, commodity, plate, AWB"
                />
                <button class="search-clear" type="button" data-clear-search hidden aria-label="Clear search">
                  ×
                </button>
              </div>
            </div>

            <div class="field">
              <label for="status">Stage</label>
              <select id="status" name="status" data-status-select>
                <option value="" selected={status === ''}>
                  All stages
                </option>
                {GROUPS.map((g) => (
                  <option value={g} selected={status === g}>
                    {GROUP_LABEL[g]}
                  </option>
                ))}
              </select>
            </div>

            <div class="field" data-sort-field hidden>
              <label for="sort">Sort by</label>
              <select id="sort" data-sort>
                <option value="newest">Sheet order</option>
                <option value="eta">Invoice date</option>
                <option value="progress">Furthest along</option>
                <option value="customer">Commodity A–Z</option>
              </select>
            </div>

            <div class="toolbar-end">
              <button class="btn btn-soft" type="submit" data-apply>
                Apply
              </button>
              <a
                class="btn btn-ghost"
                href="/orders/admin"
                data-clear-all
                data-astro-prefetch="false"
                hidden={!search && !status}
              >
                Clear filters
              </a>
            </div>
          </form>

          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Invoice / Tracking</th>
                  <th>Commodity</th>
                  <th>Cartons / Weight</th>
                  <th>Trucks</th>
                  <th>Stage</th>
                  <th>Air leg</th>
                  <th class="th-actions">Actions</th>
                </tr>
              </thead>
              <tbody data-rows>
                {orders.map((order, i) => {
                  const group = groupOf(order.stage);
                  const tone = GROUP_TONE[group];
                  return (
                    <tr
                      data-row
                      data-id={order.order_id}
                      data-status={group}
                      data-overdue="0"
                      data-search={searchText(order)}
                      data-seq={i}
                      data-eta={order.invoice_date}
                      data-step={order.stage}
                      data-step-total={ORDER_STAGE_COUNT}
                      data-customer={order.commodity.toLowerCase()}
                    >
                      <td data-label="Invoice / Tracking">
                        <span class="cell">
                          <strong>{order.invoice_number}</strong>
                          <span class="sub">{order.tracking_number || '— no code —'}</span>
                        </span>
                      </td>
                      <td data-label="Commodity">
                        <span class="cell">
                          {order.commodity || '—'}
                          <span class="sub">{formatDate(order.invoice_date)}</span>
                        </span>
                      </td>
                      <td data-label="Cartons / Weight">
                        <span class="cell">
                          {formatCount(order.cartons) || '—'}
                          <span class="sub">{formatWeight(order.gross_weight)}</span>
                        </span>
                      </td>
                      <td data-label="Trucks">
                        <span class="cell">
                          {order.kdr_plate || '—'}
                          <span class="sub">{order.tas_plate ? `TAS ${order.tas_plate}` : ''}</span>
                        </span>
                      </td>
                      <td data-label="Stage">
                        <span class="status-cell">
                          <span class="badges">
                            <span class={`badge badge-${tone}`} data-badge>
                              {GROUP_LABEL[group]}
                            </span>
                          </span>
                          {/* The stage the sheet's own dates put it on. */}
                          <span class="sub" data-stage>
                            {order.stage >= 1 ? `${order.stage}. ` : ''}
                            {stageTitle(order)}
                            {stageDate(order) ? ` · ${formatDate(stageDate(order))}` : ''}
                          </span>
                          <span class="progress" aria-hidden="true">
                            <i
                              data-bar
                              class={`bar-${tone}`}
                              style={`width:${Math.round((order.stage / ORDER_STAGE_COUNT) * 100)}%`}
                            />
                          </span>
                        </span>
                      </td>
                      <td data-label="Air leg">
                        <span class="cell">
                          {order.awb_no || '—'}
                          <span class="sub">
                            {[order.flight_no, order.flight_date ? formatDate(order.flight_date) : '']
                              .filter(Boolean)
                              .join(' · ')}
                          </span>
                        </span>
                      </td>
                      <td class="actions">
                        <div class="actions-inner">
                          <form
                            method="post"
                            action="/api/orders/receive"
                            data-receive
                            hidden={order.stage >= ORDER_STAGE_COUNT}
                          >
                            <input type="hidden" name="id" value={order.order_id} />
                            <button class="btn btn-ok" type="submit" title="Mark delivered to Delhi">
                              ✓ Delivered
                            </button>
                          </form>
                          <a class="btn btn-edit" href={`/orders/admin/${encodeURIComponent(order.order_id)}`}>
                            Edit
                          </a>
                        </div>
                      </td>
                    </tr>
                  );
                })}
                <tr data-empty hidden={orders.length > 0}>
                  <td colspan="7" class="empty" data-empty-text>
                    {loadError
                      ? 'Shipments could not be loaded.'
                      : 'No shipments in the sheet yet. Add a row and press Refresh.'}
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </TrackerAdminLayout>
  )
}

<script>
  import { initOrdersAdmin } from '../../../scripts/orders-admin';
  initOrdersAdmin();
</script>

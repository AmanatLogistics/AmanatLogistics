---
/**
 * The orders admin moved into the tracking section, at /tracking/orders/admin.
 *
 * This route stays so an existing bookmark still lands on the panel, filters
 * and all. The session cookie is unchanged, so anyone already signed in stays
 * signed in across the move.
 */
export const prerender = false;

const target = new URL(Astro.url);
target.pathname = '/tracking/orders/admin';
return Astro.redirect(`${target.pathname}${target.search}`, 307);
---

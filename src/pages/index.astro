---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ImageFrame from '../components/ImageFrame.astro';
import RouteMap from '../components/RouteMap.astro';
import Picture from '../components/Picture.astro';
import SwallowMark from '../components/SwallowMark.astro';
import { getContent } from '../lib/store';
import { liveStats, roundedPlus } from '../lib/orders/stats';

export const prerender = false;

const {
  brand,
  hero,
  stats: adminStats,
  services,
  why,
  destinations,
  logistics,
  exports: cargoTypes,
  contact,
  partner,
  partnerStats,
} = await getContent();

// The partnership band needs a name to say who the partner is; without one, or
// with "Hide" chosen in /admin, it stays off the page along with the hero link.
const showPartner = partner.show !== 'Hide' && Boolean(partner.name?.trim());
const partnerFigures = partnerStats.filter((f) => f.value?.trim() && f.label?.trim()).slice(0, 5);
const partnerLink = partner.link?.trim() || '';

/**
 * A trust number whose value is the word "auto" is worked out from the
 * SHIPMENTS sheet instead of being typed in, so it stays true on its own.
 * Which figure it takes is read from the stat's own label — tonnes for one
 * about weight, completed shipments for one about orders.
 *
 * Opt-in on purpose, rather than simply taking over. The sheet holds the
 * shipments it holds: if it covers the last few months rather than the whole
 * history of the business, switching these over automatically would have
 * quietly replaced "1,200+ Orders Completed" on the public home page with the
 * handful the sheet knows about. That is the office's call to make, one stat at
 * a time, in /admin → Trust numbers.
 *
 * Anything else — the sheet unreachable, a label that matches nothing — leaves
 * the admin's own figure in place. A visitor never sees a failure.
 */
const wantsLive = adminStats.some((s) => s.value.trim().toLowerCase() === 'auto');
const live = wantsLive ? await liveStats() : null;

const fromSheet = (label: string): string | null => {
  if (!live) return null;
  const l = label.toLowerCase();
  if (l.includes('ton')) return roundedPlus(live.tonnes);
  if (l.includes('order') || l.includes('shipment') || l.includes('deliver')) {
    return roundedPlus(live.delivered);
  }
  return null;
};

const STATS = adminStats
  .map((stat) => {
    if (stat.value.trim().toLowerCase() !== 'auto') return stat;
    return { ...stat, value: fromSheet(stat.label) };
  })
  // A stat asking for a live figure that cannot be had — the sheet unreachable,
  // or a label matching none of them — is dropped rather than shown as a dash.
  // Three honest numbers read better than four with a hole in them.
  .filter((stat): stat is { value: string; label: string } => Boolean(stat.value));

// "India, Canada, United Kingdom & United States" — built from the live list
const names = destinations.map((d) => d.name);
const countryList =
  names.length > 1 ? `${names.slice(0, -1).join(', ')} & ${names.at(-1)}` : (names[0] ?? '');

// Line icons for the "What we do" cards, fixed by position like the freight
// modes on /services; titles and text come from /admin → What we do cards.
const logisticsIcons = [
  // road freight — truck
  '<rect x="3" y="7" width="12" height="9" rx="1"/><path d="M15 10h4l2 3v3h-6z"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>',
  // air cargo — plane
  '<path d="M3 13.5 21 7v2.5l-8 4.5-2.5 5H9l1-5-5 1.5z"/>',
  // sea freight — ship
  '<path d="M3 15h18l-2.5 4.5h-13z"/><path d="M6 15V9h12v6"/><path d="M12 9V4"/>',
  // customs — stamp
  '<path d="M9 4h6v5l-1.5 2h-3L9 9z"/><path d="M5 14h14v3H5z"/><path d="M4 20h16"/>',
  // documents
  '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M10 12h5M10 15.5h5"/>',
  // warehouse
  '<path d="M3 9.5 12 4l9 5.5V20H3z"/><path d="M7 20v-7h10v7"/><path d="M7 16.5h10"/>',
];
const services6 = logistics.map((c, i) => ({ ...c, svg: logisticsIcons[i % logisticsIcons.length] }));
---

<BaseLayout title="Home" active="/">
  <!-- ============ HERO ============ -->
  <!--
    Two columns on a wide screen: the pitch on the left, and on the right the
    thing most returning visitors came for — tracking a shipment. It used to be
    a separate band further down the page; up here it is one glance away.
  -->
  <section class="relative overflow-hidden bg-fig">
    <ImageFrame
      src={hero.image}
      alt="Palletised cargo being loaded onto an aircraft"
      tone="plum"
      loading="eager"
      class="absolute inset-0 h-full w-full"
      label="FULL-WIDTH IMAGE: cargo being loaded / trucks / warehouse<br>at least 2400×1100px"
    />
    <!-- navy scrim, heaviest behind the text, with a faint route grid on top -->
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(80% 90% at 92% 0%, rgba(229,154,28,0.16) 0%, rgba(229,154,28,0) 55%),
        linear-gradient(100deg, rgba(9,19,31,0.97) 0%, rgba(13,27,42,0.9) 45%, rgba(13,27,42,0.62) 100%);"
    >
    </div>
    <div class="route-grid absolute inset-0"></div>

    <div class="relative mx-auto grid max-w-[1240px] grid-cols-1 items-center gap-12 px-5 pb-28 pt-20 md:px-10 md:pb-36 md:pt-28 lg:grid-cols-[1.25fr_0.75fr] lg:gap-16">
      <div class="flex flex-col items-start gap-6">
        <span class="eyebrow inline-flex items-center gap-2 rounded-md border border-white/15 bg-white/5 px-3 py-1.5 text-gold-light">
          <span class="h-2 w-2 rounded-full bg-accent"></span>
          {hero.eyebrow}
        </span>
        <h1 class="m-0 max-w-[15ch] font-serif text-[44px] font-bold uppercase leading-[0.98] tracking-[-0.01em] text-[#F5F7FA] sm:text-[58px] md:text-[72px]" style="text-wrap:balance;">
          {hero.title}
        </h1>
        <p class="m-0 max-w-[52ch] text-[17px] leading-relaxed text-[#C6D0DC] md:text-[19px]">
          {hero.subtitle}
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <a href="/contact#form" class="rounded-md bg-accent px-7 py-3.5 text-[15.5px] font-bold text-ink shadow-[0_10px_30px_rgba(229,154,28,0.30)] transition hover:-translate-y-0.5 hover:bg-gold-light">
            Request a Quote
          </a>
          <a href="/services" class="group flex items-center gap-2 rounded-md border border-white/20 px-6 py-3.5 text-[15.5px] font-semibold text-[#F5F7FA] transition-colors hover:border-gold-light hover:text-gold-light">
            Our services
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
        <ul class="m-0 mt-1 flex list-none flex-wrap gap-x-5 gap-y-2 p-0 text-[14px] font-semibold uppercase tracking-[0.08em] text-[#9DAABA]">
          {['Road', 'Air', 'Sea', 'Customs', 'Warehousing'].map((m) => (
            <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rotate-45 bg-accent"></span>{m}</li>
          ))}
        </ul>
        {
          showPartner && (
            <a
              href="#partnership"
              class="mt-1 inline-flex items-center gap-3 rounded-lg border border-white/15 bg-white/5 py-1.5 pl-1.5 pr-5 transition-colors hover:border-gold-light/70"
            >
              <span class="flex h-9 w-9 flex-none items-center justify-center overflow-hidden rounded-md bg-[#F5F7FA]">
                {partner.logo ? (
                  <Picture src={partner.logo} alt="" class="h-7 w-7 object-contain" />
                ) : (
                  <svg width="36" height="36" viewBox="0 0 48 48" aria-hidden="true">
                    <rect width="48" height="48" fill="#1f4d3b" />
                    <path d="M13 13h11v3.6h-7v5h6v3.6h-6V35h-4Z" fill="#e2a72e" />
                    <path d="M24 17h11v3.6h-7v5h6v3.6h-6V39h-4Z" fill="#f6ecd2" />
                  </svg>
                )}
              </span>
              <span class="flex flex-col leading-tight">
                <small class="text-[11px] font-bold uppercase tracking-[0.14em] text-gold-light/85">In partnership with</small>
                <strong class="text-[15px] font-semibold text-[#F5F7FA]">{partner.name}</strong>
              </span>
            </a>
          )
        }
      </div>

      <!-- Track a shipment. Plain GET form: submits straight to the tracking page, no JS needed. -->
      <div class="rounded-xl bg-paper p-6 shadow-[0_24px_60px_rgba(0,0,0,0.35)] md:p-8">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-md bg-fig text-gold-light">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" />
            </svg>
          </span>
          <div class="flex flex-col">
            <span class="eyebrow text-[11px] text-label">Already shipped with us?</span>
            <h2 class="m-0 font-serif text-[24px] font-bold leading-tight text-ink">Track your shipment</h2>
          </div>
        </div>
        <form method="get" action="/tracking" class="mt-6 flex flex-col gap-3">
          <label for="home-track" class="text-[13.5px] font-semibold text-muted-dark">Tracking or invoice number</label>
          <input
            id="home-track"
            name="code"
            type="text"
            required
            placeholder="Enter your number"
            class="amn-field rounded-md border border-line bg-cream px-4 py-3.5 text-[15.5px] text-ink placeholder:text-muted/70"
          />
          <button
            type="submit"
            class="rounded-md bg-fig px-6 py-3.5 text-[15.5px] font-bold text-[#F5F7FA] transition-colors hover:bg-plum"
          >
            Track Now
          </button>
        </form>
        <div class="mt-6 border-t border-line pt-5 text-[14.5px] leading-relaxed text-muted">
          Need a price instead? Call or WhatsApp{' '}
          <a href={`tel:${contact.phoneExport.replace(/\s/g, '')}`} class="whitespace-nowrap font-semibold text-plum hover:text-plum-hover">{contact.phoneExport}</a>.
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST STATS ============ -->
  <!-- A white strip that overlaps the foot of the hero, so the numbers read as
       part of the opening rather than as a separate band. -->
  <section class="relative z-10 bg-cream px-5 md:px-10">
    <div class="mx-auto -mt-14 grid max-w-[1240px] grid-cols-2 overflow-hidden rounded-xl border border-line bg-paper shadow-[0_14px_40px_rgba(15,26,38,0.10)] md:grid-cols-4">
      {
        STATS.map((s, i) => (
          <div class:list={[
            'flex flex-col gap-1 px-6 py-6 md:px-8 md:py-7',
            i % 2 === 1 && 'border-l border-line',
            i >= 2 && 'border-t border-line md:border-t-0',
            i === 2 && 'md:border-l',
          ]}>
            <span class="font-serif text-[30px] font-bold leading-none text-ink md:text-[38px]">{s.value}</span>
            <span class="eyebrow text-[11.5px] text-muted md:text-[12px]">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ WHAT WE DO ============ -->
  <!--
    Amanat is a logistics company: what a visitor should learn first is what it
    can move and how. These cards say that in six lines.

    The intro above them (/admin → Service descriptions) is what used to head a
    "Two services" pair of cards, before personal shopping was dropped.
  -->
  <section class="bg-cream">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-10 px-5 pb-20 pt-16 md:px-10 md:pb-24 md:pt-20">
      <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end reveal">
        <div class="flex max-w-[640px] flex-col gap-4">
          <Eyebrow text={services.exportTitle || 'What We Do'} />
          <h2 class="m-0 font-serif text-[32px] font-bold leading-[1.05] text-plum md:text-[44px]">
            Everything it takes to move your cargo.
          </h2>
          {services.exportText && <p class="m-0 text-[16.5px] leading-relaxed text-muted">{services.exportText}</p>}
        </div>
        <a
          href="/services"
          class="flex flex-none items-center gap-2 text-[15.5px] font-bold text-accent-deep transition-colors hover:text-plum"
        >
          See all services <span class="text-[17px]">→</span>
        </a>
      </div>

      <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {
          services6.map((c, i) => (
            <li class="group relative flex flex-col gap-3 overflow-hidden rounded-xl border border-line bg-paper p-7 transition duration-300 hover:-translate-y-1 hover:border-[#C3CBD5] hover:shadow-[0_18px_40px_rgba(15,26,38,0.10)] reveal md:p-8">
              <span class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-accent transition-transform duration-300 group-hover:scale-x-100"></span>
              <div class="mb-2 flex items-start justify-between">
                <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-fig text-gold-light">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.svg} />
                </span>
                <span class="font-serif text-[15px] font-bold tracking-[0.06em] text-[#C3CBD5]">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="m-0 font-serif text-[22px] font-bold leading-snug text-ink">{c.title}</h3>
              <p class="m-0 text-[15.5px] leading-relaxed text-muted">{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ CARGO WE SPECIALISE IN ============ -->
  <!--
    The small share of the page that is about produce. Most of what leaves
    Kandahar with Amanat is dry fruit and fresh fruit, and knowing how to carry
    it is a real selling point — but it is the cargo, not the business. The
    tiles come from /admin → Cargo we carry; general cargo closes the row so the
    point lands: this is what we know best, not all we move.
  -->
  <section class="border-y border-line bg-paper">
    <div class="mx-auto grid max-w-[1240px] grid-cols-1 items-center gap-10 px-5 py-16 md:px-10 md:py-20 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="flex flex-col gap-4 reveal">
        <Eyebrow text="Cargo We Specialise In" />
        <h2 class="m-0 font-serif text-[28px] font-bold leading-[1.08] text-plum md:text-[36px]">
          Kandahar's dry fruit and fresh produce — and any other cargo.
        </h2>
        <p class="m-0 text-[16px] leading-relaxed text-muted">
          Most of what leaves Kandahar with us is dry fruit, nuts and fresh fruit, so perishable, food-grade cargo is what we know best: ventilated loading, cold storage, and the phytosanitary papers buyers ask for. General cargo travels the same careful way.
        </p>
        <a href="/services" class="mt-1 flex items-center gap-2 self-start text-[15.5px] font-bold text-accent-deep transition-colors hover:text-plum">
          Cargo we carry <span class="text-[17px]">→</span>
        </a>
      </div>
      <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-3">
        {
          cargoTypes.slice(0, 5).map((c) => (
            <li class="group relative overflow-hidden rounded-lg border border-line reveal">
              <ImageFrame
                src={c.img}
                alt={c.alt}
                label={c.name}
                sizes="(max-width: 640px) 46vw, 220px"
                class="h-[118px] w-full transition-transform duration-500 group-hover:scale-[1.05] md:h-[132px]"
              />
              <div
                class="pointer-events-none absolute inset-x-0 bottom-0 px-3 pb-2.5 pt-8"
                style="background:linear-gradient(0deg,rgba(13,27,42,0.88),rgba(13,27,42,0));"
              >
                <span class="text-[14.5px] font-semibold text-[#F5F7FA]">{c.name}</span>
              </div>
            </li>
          ))
        }
        <li class="flex h-[118px] flex-col justify-between rounded-lg bg-fig p-3.5 md:h-[132px]">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#f6c25c" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 8 12 3 3 8v8l9 5 9-5Z" /><path d="M3 8l9 5 9-5M12 13v8" />
          </svg>
          <span class="text-[14.5px] font-semibold text-[#F5F7FA]">General cargo</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ PARTNERSHIP ============ -->
  <!--
    Faiz Fayez LTD's own site tells its buyers that Amanat Logistics carries
    their fruit. This is the same partnership said from this side, so a buyer
    arriving here sees it too. Text, figures and the on/off switch are in
    /admin → Partnership.
  -->
  {
    showPartner && (
      <section id="partnership" class="scroll-mt-24 bg-cream">
        <div class="mx-auto max-w-[1240px] px-5 py-20 md:px-10 md:py-[88px]">
          <div class="grid grid-cols-1 overflow-hidden rounded-xl border border-line bg-paper shadow-[0_14px_40px_rgba(15,26,38,0.08)] reveal lg:grid-cols-[1.15fr_1fr]">
            <div class="flex flex-col items-start gap-5 p-8 md:p-12">
              <div class="flex items-center gap-3" aria-hidden="true">
                <span class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-xl border border-line bg-paper">
                  {brand.logo ? (
                    <Picture src={brand.logo} alt="" class="h-12 w-12 object-contain" />
                  ) : (
                    <SwallowMark class="w-9 text-plum" />
                  )}
                </span>
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent/15 text-accent-deep">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m11 17 2 2a1 1 0 1 0 3-3" />
                    <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" />
                    <path d="m21 3 1 11h-2" />
                    <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" />
                    <path d="M3 4h8" />
                  </svg>
                </span>
                <span class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-xl border border-line bg-paper">
                  {partner.logo ? (
                    <Picture src={partner.logo} alt="" class="h-12 w-12 object-contain" />
                  ) : (
                    <svg width="46" height="46" viewBox="0 0 48 48">
                      <rect width="48" height="48" rx="12" fill="#1f4d3b" />
                      <rect x="5.5" y="5.5" width="37" height="37" rx="8.5" fill="none" stroke="#e2a72e" stroke-opacity=".5" stroke-width="1" />
                      <path d="M13 13h11v3.6h-7v5h6v3.6h-6V35h-4Z" fill="#e2a72e" />
                      <path d="M24 17h11v3.6h-7v5h6v3.6h-6V39h-4Z" fill="#f6ecd2" />
                    </svg>
                  )}
                </span>
              </div>

              {partner.eyebrow && <Eyebrow text={partner.eyebrow} />}
              <h2 class="m-0 font-serif text-[28px] font-bold leading-tight text-plum md:text-[36px]" style="text-wrap:balance;">
                {partner.title || `In partnership with ${partner.name}`}
              </h2>
              {partner.text && <p class="m-0 max-w-[58ch] text-[16px] leading-relaxed text-muted">{partner.text}</p>}

              <p class="m-0 flex flex-col gap-0.5 text-[14px] text-muted">
                <strong class="font-semibold text-ink">{partner.name}</strong>
                <span>{[partner.role, partner.since && `Partners since ${partner.since}`].filter(Boolean).join(' · ')}</span>
              </p>

              {
                partnerLink && (
                  <a
                    href={partnerLink}
                    target="_blank"
                    rel="noopener"
                    class="mt-1 inline-flex items-center gap-2 rounded-md bg-plum px-7 py-3 text-[15px] font-bold text-[#F5F7FA] transition-colors hover:bg-plum-hover"
                  >
                    {partner.button || `Visit ${partner.name}`} <span aria-hidden="true">↗</span>
                  </a>
                )
              }
            </div>

            {
              partnerFigures.length > 0 && (
                <ul class="m-0 grid list-none auto-rows-fr grid-cols-2 gap-px bg-[#1b2c3f] p-0">
                  {partnerFigures.map((f, i) => (
                    <li
                      class:list={[
                        'flex flex-col justify-center gap-1.5 bg-fig px-7 py-8 md:px-9',
                        // The first figure — the total — gets the full width, and so
                        // does a last one that would otherwise sit alone in its row.
                        (i === 0 || (i === partnerFigures.length - 1 && i % 2 === 1)) && 'col-span-2',
                        i === 0 && 'bg-plum md:py-10',
                      ]}
                    >
                      <span class:list={['font-serif font-bold leading-none text-gold-light', i === 0 ? 'text-[44px] md:text-[54px]' : 'text-[30px] md:text-[34px]']}>
                        {f.value}
                      </span>
                      <span class="eyebrow text-[12px] text-[#C6D0DC] md:text-[12.5px]">{f.label}</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ WHY AMANAT ============ -->
  <section class="bg-paper">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-10 px-5 py-20 md:px-10 md:py-24">
      <div class="flex max-w-[640px] flex-col gap-4 reveal">
        <Eyebrow text="Why Amanat" />
        <h2 class="m-0 font-serif text-[32px] font-bold leading-[1.05] text-plum md:text-[44px]">One team, answerable from pickup to delivery.</h2>
      </div>
      <div class="grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
        {
          why.map((c, i) => (
            <div class="flex flex-col gap-3 bg-paper p-8 reveal md:p-9">
              <span class="font-serif text-[40px] font-bold leading-none text-accent">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-serif text-[22px] font-bold leading-snug text-ink">{c.title}</span>
              <span class="text-[15.5px] leading-relaxed text-muted">{c.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ ROUTES PREVIEW ============ -->
  <section class="route-grid relative overflow-hidden bg-fig">
    <div class="relative mx-auto grid max-w-[1240px] grid-cols-1 items-center gap-12 px-5 py-20 md:grid-cols-[0.9fr_1.1fr] md:gap-[72px] md:px-10 md:py-24">
      <div class="flex flex-col gap-[22px]">
        <Eyebrow text="Routes & Coverage" tone="dark" />
        <h2 class="m-0 font-serif text-[32px] font-bold leading-[1.08] text-[#F5F7FA] md:text-[44px]" style="text-wrap:pretty;">
          We currently ship to {countryList} — with more destinations coming.
        </h2>
        <div class="mt-1 flex flex-wrap gap-2.5">
          {destinations.map((d) => (
            <span class="rounded-md border border-[#34506e] bg-white/5 px-4 py-1.5 text-[14px] font-semibold text-[#C6D0DC]">{d.name}</span>
          ))}
          <span class="rounded-md border border-dashed border-[#34506e] px-4 py-1.5 text-[14px] font-semibold text-[#f6c25c]">More coming</span>
        </div>
        <a href="/contact" class="mt-2 flex items-center gap-2 self-start text-[15px] font-semibold text-gold-light transition-colors hover:text-[#F5F7FA]">
          Ask about your destination <span class="text-[17px]">→</span>
        </a>
      </div>
      <div class="rounded-2xl border border-[#22364d] bg-[#07121e]/40 p-4 md:p-6">
        <RouteMap destinations={destinations} class="h-auto w-full" />
      </div>
    </div>
  </section>
</BaseLayout>

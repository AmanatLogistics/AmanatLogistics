---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ImageFrame from '../components/ImageFrame.astro';
import RouteMap from '../components/RouteMap.astro';
import Picture from '../components/Picture.astro';
import SwallowMark from '../components/SwallowMark.astro';
import { getContent } from '../lib/store';
import { liveStats, roundedPlus } from '../lib/orders/stats';

export const prerender = false;

const {
  brand,
  hero,
  stats: adminStats,
  services,
  why,
  destinations,
  logistics,
  partner,
  partnerStats,
} = await getContent();

// The partnership band needs a name to say who the partner is; without one, or
// with "Hide" chosen in /admin, it stays off the page along with the hero link.
const showPartner = partner.show !== 'Hide' && Boolean(partner.name?.trim());
const partnerFigures = partnerStats.filter((f) => f.value?.trim() && f.label?.trim()).slice(0, 5);
const partnerLink = partner.link?.trim() || '';

/**
 * A trust number whose value is the word "auto" is worked out from the
 * SHIPMENTS sheet instead of being typed in, so it stays true on its own.
 * Which figure it takes is read from the stat's own label — tonnes for one
 * about weight, completed shipments for one about orders.
 *
 * Opt-in on purpose, rather than simply taking over. The sheet holds the
 * shipments it holds: if it covers the last few months rather than the whole
 * history of the business, switching these over automatically would have
 * quietly replaced "1,200+ Orders Completed" on the public home page with the
 * handful the sheet knows about. That is the office's call to make, one stat at
 * a time, in /admin → Trust numbers.
 *
 * Anything else — the sheet unreachable, a label that matches nothing — leaves
 * the admin's own figure in place. A visitor never sees a failure.
 */
const wantsLive = adminStats.some((s) => s.value.trim().toLowerCase() === 'auto');
const live = wantsLive ? await liveStats() : null;

const fromSheet = (label: string): string | null => {
  if (!live) return null;
  const l = label.toLowerCase();
  if (l.includes('ton')) return roundedPlus(live.tonnes);
  if (l.includes('order') || l.includes('shipment') || l.includes('deliver')) {
    return roundedPlus(live.delivered);
  }
  return null;
};

const STATS = adminStats
  .map((stat) => {
    if (stat.value.trim().toLowerCase() !== 'auto') return stat;
    return { ...stat, value: fromSheet(stat.label) };
  })
  // A stat asking for a live figure that cannot be had — the sheet unreachable,
  // or a label matching none of them — is dropped rather than shown as a dash.
  // Three honest numbers read better than four with a hole in them.
  .filter((stat): stat is { value: string; label: string } => Boolean(stat.value));

// "India, Canada, United Kingdom & United States" — built from the live list
const names = destinations.map((d) => d.name);
const countryList =
  names.length > 1 ? `${names.slice(0, -1).join(', ')} & ${names.at(-1)}` : (names[0] ?? '');

// Line icons for the "What we do" cards, fixed by position like the freight
// modes on /services; titles and text come from /admin → What we do cards.
const logisticsIcons = [
  // road freight — truck
  '<rect x="3" y="7" width="12" height="9" rx="1"/><path d="M15 10h4l2 3v3h-6z"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>',
  // air cargo — plane
  '<path d="M3 13.5 21 7v2.5l-8 4.5-2.5 5H9l1-5-5 1.5z"/>',
  // sea freight — ship
  '<path d="M3 15h18l-2.5 4.5h-13z"/><path d="M6 15V9h12v6"/><path d="M12 9V4"/>',
  // customs — stamp
  '<path d="M9 4h6v5l-1.5 2h-3L9 9z"/><path d="M5 14h14v3H5z"/><path d="M4 20h16"/>',
  // documents
  '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M10 12h5M10 15.5h5"/>',
  // warehouse
  '<path d="M3 9.5 12 4l9 5.5V20H3z"/><path d="M7 20v-7h10v7"/><path d="M7 16.5h10"/>',
];
const services6 = logistics.map((c, i) => ({ ...c, svg: logisticsIcons[i % logisticsIcons.length] }));
---

<BaseLayout title="Home" active="/">
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-fig">
    <ImageFrame
      src={hero.image}
      alt="Palletised cargo being loaded onto an aircraft"
      tone="plum"
      loading="eager"
      class="absolute inset-0 h-full w-full"
      label="FULL-WIDTH IMAGE: cargo being loaded / trucks / warehouse<br>at least 2400×1100px"
    />
    <!-- warm layered light: amber glow + wine scrim (reads rich with or without a photo) -->
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(115% 125% at 88% 8%, rgba(198,137,47,0.28) 0%, rgba(198,137,47,0) 46%),
        radial-gradient(90% 120% at 0% 100%, rgba(53,20,29,0.85) 0%, rgba(53,20,29,0) 55%),
        linear-gradient(103deg, rgba(41,16,22,0.96) 0%, rgba(72,24,40,0.82) 48%, rgba(72,24,40,0.5) 100%);"
    >
    </div>

    <div class="relative mx-auto flex max-w-[1240px] flex-col items-start gap-6 px-5 py-24 md:px-10 md:py-[136px]">
      <div class="flex items-center gap-3">
        <span class="h-px w-9 bg-gold-light/70"></span>
        <span class="eyebrow text-gold-light">{hero.eyebrow}</span>
      </div>
      <h1 class="m-0 max-w-[16ch] font-serif text-[42px] font-semibold leading-[1.04] text-[#F7ECDA] sm:text-[56px] md:text-[68px]" style="text-wrap:balance;">
        {hero.title}
      </h1>
      <p class="m-0 max-w-[50ch] text-[17px] leading-relaxed text-[#E4CFC2] md:text-[19px]">
        {hero.subtitle}
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-4">
        <a href="/contact#form" class="rounded-full bg-gold px-8 py-3.5 text-[15px] font-semibold text-ink shadow-[0_8px_24px_rgba(192,135,46,0.32)] transition-transform hover:-translate-y-0.5">
          Request a Quote
        </a>
        <a href="/services" class="group flex items-center gap-2 px-3 py-3.5 text-[15px] font-semibold text-[#F0E7DD] transition-colors hover:text-gold-light">
          Explore our services
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
      {
        showPartner && (
          <a
            href="#partnership"
            class="mt-2 inline-flex items-center gap-3 rounded-full border border-[#E6BD6D]/30 bg-[#2c1119]/45 py-1.5 pl-1.5 pr-5 transition-colors hover:border-gold-light/70"
          >
            <span class="flex h-9 w-9 flex-none items-center justify-center overflow-hidden rounded-full bg-[#F7ECDA]">
              {partner.logo ? (
                <Picture src={partner.logo} alt="" class="h-7 w-7 object-contain" />
              ) : (
                <svg width="36" height="36" viewBox="0 0 48 48" aria-hidden="true">
                  <rect width="48" height="48" fill="#1f4d3b" />
                  <path d="M13 13h11v3.6h-7v5h6v3.6h-6V35h-4Z" fill="#e2a72e" />
                  <path d="M24 17h11v3.6h-7v5h6v3.6h-6V39h-4Z" fill="#f6ecd2" />
                </svg>
              )}
            </span>
            <span class="flex flex-col leading-tight">
              <small class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold-light/80">In partnership with</small>
              <strong class="text-[14.5px] font-semibold text-[#F7ECDA]">{partner.name}</strong>
            </span>
          </a>
        )
      }
    </div>
  </section>

  <!-- ============ TRUST STATS ============ -->
  <section class="border-b border-line bg-sand">
    <div class="mx-auto grid max-w-[1240px] grid-cols-2 gap-8 px-5 py-11 md:grid-cols-4 md:px-10">
      {
        STATS.map((s, i) => (
          <div class:list={['flex flex-col items-center gap-1.5 text-center', i > 0 && 'md:border-l md:border-[#DDD1BC]']}>
            <span class="font-serif text-[30px] font-bold text-plum md:text-[34px]">{s.value}</span>
            <span class="eyebrow text-[12px] text-label md:text-[13px]">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ TRACK A SHIPMENT ============ -->
  <section class="border-b border-line bg-cream">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-6 px-5 py-12 md:flex-row md:items-center md:justify-between md:px-10 md:py-14">
      <div class="flex max-w-[46ch] flex-col gap-2">
        <Eyebrow text="Already Shipped With Us?" />
        <h2 class="m-0 font-serif text-[26px] font-bold leading-tight text-plum md:text-[30px]">
          Track your shipment
        </h2>
        <p class="m-0 text-[15.5px] leading-relaxed text-muted">
          Enter your tracking number or invoice number to see exactly where your consignment is.
        </p>
      </div>

      <!-- Plain GET form: submits straight to the tracking page, no JS needed. -->
      <form method="get" action="/tracking" class="flex w-full flex-col gap-3 sm:flex-row md:max-w-[520px]">
        <label for="home-track" class="sr-only">Tracking number or invoice number</label>
        <input
          id="home-track"
          name="code"
          type="text"
          required
          placeholder="Tracking or invoice number"
          class="amn-field flex-1 rounded-lg border border-line bg-paper px-4 py-3.5 text-[15px] text-ink placeholder:text-muted/70"
        />
        <button
          type="submit"
          class="rounded-lg bg-accent px-7 py-3.5 text-[15px] font-semibold text-paper transition-colors hover:bg-plum-hover"
        >
          Track Now
        </button>
      </form>
    </div>
  </section>

  <!-- ============ WHAT WE DO ============ -->
  <!--
    Amanat is a logistics company: what a visitor should learn first is what it
    can move and how. These cards say that in six lines. The produce photos
    that used to sit here are still on /services, under "Cargo We Carry".

    This used to follow a "Two services" pair of cards, freight and personal
    shopping. Amanat no longer offers shopping, and a pair of one is just the
    intro to this section — so that intro (/admin → Service descriptions) now
    sits here, above the cards it introduces.
  -->
  <section class="bg-sand">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-10 px-5 py-20 md:px-10 md:py-[88px]">
      <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end reveal">
        <div class="flex max-w-[640px] flex-col gap-4">
          <Eyebrow text={services.exportTitle || 'What We Do'} />
          <h2 class="m-0 font-serif text-[30px] font-bold leading-tight text-plum md:text-[38px]">
            Everything it takes to move your cargo.
          </h2>
          {services.exportText && <p class="m-0 text-[16px] leading-relaxed text-muted">{services.exportText}</p>}
        </div>
        <a
          href="/services"
          class="flex flex-none items-center gap-2 text-[15px] font-semibold text-accent-deep transition-colors hover:text-plum"
        >
          See all services <span class="text-[17px]">→</span>
        </a>
      </div>

      <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {
          services6.map((c) => (
            <li class="flex flex-col gap-3 rounded-xl border border-line bg-paper p-7 reveal md:p-8">
              <span class="mb-1 flex h-12 w-12 items-center justify-center rounded-lg bg-plum text-gold-light">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.svg} />
              </span>
              <h3 class="m-0 font-serif text-[20px] font-bold leading-snug text-plum">{c.title}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-muted">{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ PARTNERSHIP ============ -->
  <!--
    Faiz Fayez LTD's own site tells its buyers that Amanat Logistics carries
    their fruit. This is the same partnership said from this side, so a buyer
    arriving here sees it too. Text, figures and the on/off switch are in
    /admin → Partnership.
  -->
  {
    showPartner && (
      <section id="partnership" class="scroll-mt-24 border-t border-line bg-paper">
        <div class="mx-auto max-w-[1240px] px-5 py-20 md:px-10 md:py-[88px]">
          <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-line bg-cream shadow-[0_8px_28px_rgba(61,34,51,0.08)] reveal lg:grid-cols-[1.15fr_1fr]">
            <div class="flex flex-col items-start gap-5 p-8 md:p-12">
              <div class="flex items-center gap-3" aria-hidden="true">
                <span class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-xl border border-line bg-paper">
                  {brand.logo ? (
                    <Picture src={brand.logo} alt="" class="h-12 w-12 object-contain" />
                  ) : (
                    <SwallowMark class="w-9 text-plum" />
                  )}
                </span>
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent/15 text-accent-deep">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m11 17 2 2a1 1 0 1 0 3-3" />
                    <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" />
                    <path d="m21 3 1 11h-2" />
                    <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" />
                    <path d="M3 4h8" />
                  </svg>
                </span>
                <span class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-xl border border-line bg-paper">
                  {partner.logo ? (
                    <Picture src={partner.logo} alt="" class="h-12 w-12 object-contain" />
                  ) : (
                    <svg width="46" height="46" viewBox="0 0 48 48">
                      <rect width="48" height="48" rx="12" fill="#1f4d3b" />
                      <rect x="5.5" y="5.5" width="37" height="37" rx="8.5" fill="none" stroke="#e2a72e" stroke-opacity=".5" stroke-width="1" />
                      <path d="M13 13h11v3.6h-7v5h6v3.6h-6V35h-4Z" fill="#e2a72e" />
                      <path d="M24 17h11v3.6h-7v5h6v3.6h-6V39h-4Z" fill="#f6ecd2" />
                    </svg>
                  )}
                </span>
              </div>

              {partner.eyebrow && <Eyebrow text={partner.eyebrow} />}
              <h2 class="m-0 font-serif text-[28px] font-bold leading-tight text-plum md:text-[36px]" style="text-wrap:balance;">
                {partner.title || `In partnership with ${partner.name}`}
              </h2>
              {partner.text && <p class="m-0 max-w-[58ch] text-[16px] leading-relaxed text-muted">{partner.text}</p>}

              <p class="m-0 flex flex-col gap-0.5 text-[14px] text-muted">
                <strong class="font-semibold text-ink">{partner.name}</strong>
                <span>{[partner.role, partner.since && `Partners since ${partner.since}`].filter(Boolean).join(' · ')}</span>
              </p>

              {
                partnerLink && (
                  <a
                    href={partnerLink}
                    target="_blank"
                    rel="noopener"
                    class="mt-1 inline-flex items-center gap-2 rounded-full bg-plum px-7 py-3 text-[15px] font-semibold text-[#F8F3E9] transition-colors hover:bg-plum-hover"
                  >
                    {partner.button || `Visit ${partner.name}`} <span aria-hidden="true">↗</span>
                  </a>
                )
              }
            </div>

            {
              partnerFigures.length > 0 && (
                <ul class="m-0 grid list-none auto-rows-fr grid-cols-2 gap-px bg-[#5a1b2b] p-0">
                  {partnerFigures.map((f, i) => (
                    <li
                      class:list={[
                        'flex flex-col justify-center gap-1.5 bg-plum px-7 py-8 md:px-9',
                        // The first figure — the total — gets the full width, and so
                        // does a last one that would otherwise sit alone in its row.
                        (i === 0 || (i === partnerFigures.length - 1 && i % 2 === 1)) && 'col-span-2',
                        i === 0 && 'bg-fig md:py-10',
                      ]}
                    >
                      <span class:list={['font-serif font-bold leading-none text-gold-light', i === 0 ? 'text-[44px] md:text-[54px]' : 'text-[30px] md:text-[34px]']}>
                        {f.value}
                      </span>
                      <span class="eyebrow text-[12px] text-[#E0D2CA] md:text-[12.5px]">{f.label}</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ WHY AMANAT ============ -->
  <section class="border-t border-line bg-cream">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-11 px-5 py-20 md:px-10 md:py-[88px]">
      <Eyebrow text="Why Amanat" class="reveal" />
      <div class="grid grid-cols-1 gap-7 md:grid-cols-3">
        {
          why.map((c) => (
            <div class="flex flex-col gap-3 rounded-[10px] border border-line bg-paper p-8 reveal">
              <div class="mb-1 h-3 w-3 rotate-45 bg-accent"></div>
              <span class="font-serif text-[20px] font-bold leading-snug text-plum">{c.title}</span>
              <span class="text-[15px] leading-relaxed text-muted">{c.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ ROUTES PREVIEW ============ -->
  <section class="relative overflow-hidden bg-fig">
    <div class="relative mx-auto grid max-w-[1240px] grid-cols-1 items-center gap-12 px-5 py-20 md:grid-cols-[0.9fr_1.1fr] md:gap-[72px] md:px-10 md:py-24">
      <div class="flex flex-col gap-[22px]">
        <Eyebrow text="Routes & Coverage" tone="dark" />
        <h2 class="m-0 font-serif text-[30px] font-semibold leading-tight text-[#F6ECDA] md:text-[40px]" style="text-wrap:pretty;">
          We currently ship to {countryList} — with more destinations coming.
        </h2>
        <div class="mt-1 flex flex-wrap gap-2.5">
          {destinations.map((d) => (
            <span class="rounded-full border border-[#8a5a68] px-4 py-1.5 text-[13.5px] font-medium text-[#EDDAC4]">{d.name}</span>
          ))}
          <span class="rounded-full border border-dashed border-[#8a5a68] px-4 py-1.5 text-[13.5px] font-medium text-[#c79a6a]">More coming</span>
        </div>
        <a href="/contact" class="mt-2 flex items-center gap-2 self-start text-[15px] font-semibold text-gold-light transition-colors hover:text-[#F8F3E9]">
          Ask about your destination <span class="text-[17px]">→</span>
        </a>
      </div>
      <div class="rounded-2xl border border-[#7a3346] bg-[#2c1119]/40 p-4 md:p-6">
        <RouteMap destinations={destinations} class="h-auto w-full" />
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { STATS } from '../consts';
---

<BaseLayout title="Home" active="/">
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-plum">
    <ImageFrame
      src="/images/hero-home.jpg"
      alt="Kandahar figs and dry fruits prepared for export"
      tone="plum"
      loading="eager"
      class="absolute inset-0 h-full w-full"
      label="FULL-WIDTH IMAGE: Kandahar figs & dry fruits,<br>export cartons / cargo in warm light<br>hero-home.jpg — 2400×1100px"
    />
    <div class="absolute inset-0" style="background:linear-gradient(90deg,rgba(43,20,35,0.94) 0%,rgba(43,20,35,0.74) 52%,rgba(43,20,35,0.4) 100%);"></div>

    <div class="relative mx-auto flex max-w-[1240px] flex-col items-start gap-7 px-5 py-24 md:px-10 md:py-[132px]">
      <Eyebrow text="Kandahar, Afghanistan" tone="dark" />
      <h1 class="m-0 max-w-[18ch] font-serif text-[38px] font-bold leading-[1.12] text-[#F8F3E9] sm:text-[48px] md:text-[56px]" style="text-wrap:pretty;">
        Premium Figs &amp; Dry Fruits, From Kandahar to the World.
      </h1>
      <p class="m-0 max-w-[52ch] text-[17px] leading-relaxed text-[#D9C8BE] md:text-[18px]">
        Trusted export and freight partner delivering Afghanistan's finest produce across the globe.
      </p>
      <div class="mt-2 flex flex-wrap gap-4">
        <a href="/contact#form" class="rounded-md bg-accent px-8 py-4 text-[15px] font-semibold text-paper transition-colors hover:bg-[#C89B52] hover:text-ink">
          Request a Quote
        </a>
        <a href="/services" class="rounded-md border border-[#A88A9B] px-8 py-4 text-[15px] font-semibold text-[#F0E7DD] transition-colors hover:border-gold-light hover:text-[#F8F3E9]">
          Our Services
        </a>
      </div>
    </div>
  </section>

  <!-- ============ TRUST STATS ============ -->
  <section class="border-b border-line bg-sand">
    <div class="mx-auto grid max-w-[1240px] grid-cols-2 gap-8 px-5 py-11 md:grid-cols-4 md:px-10">
      {
        STATS.map((s, i) => (
          <div class:list={['flex flex-col items-center gap-1.5 text-center', i > 0 && 'md:border-l md:border-[#DDD1BC]']}>
            <span class="font-serif text-[30px] font-bold text-plum md:text-[34px]">{s.value}</span>
            <span class="eyebrow text-[12px] text-label md:text-[13px]">{s.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ TWO-SERVICE SPLIT ============ -->
  <section class="bg-paper">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-12 px-5 py-20 md:px-10 md:py-[104px]">
      <div class="flex max-w-[640px] flex-col gap-4 reveal">
        <Eyebrow text="Our Services" />
        <h2 class="m-0 font-serif text-[30px] font-bold leading-tight text-plum md:text-[38px]">Two services. One standard of trust.</h2>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <!-- Export & Freight -->
        <div class="flex flex-col gap-5 rounded-xl bg-plum p-9 shadow-[0_8px_28px_rgba(61,34,51,0.18)] md:p-11 reveal">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <rect x="8" y="16" width="32" height="24" rx="2" stroke="#D6B676" stroke-width="2"></rect>
            <path d="M8 24 H40" stroke="#D6B676" stroke-width="2"></path>
            <path d="M20 8 L28 8 L28 16 L20 16 Z" stroke="#D6B676" stroke-width="2"></path>
          </svg>
          <h3 class="m-0 font-serif text-[24px] font-bold leading-tight text-[#F8F3E9] md:text-[27px]">Export &amp; Freight</h3>
          <p class="m-0 text-[16px] leading-relaxed text-[#CDBBB0]">
            Premium figs, dry fruits, and fresh fruits from Afghanistan — shipped by sea, air, and land with certified documentation and careful handling at every step.
          </p>
          <a href="/services" class="mt-1 flex items-center gap-2 text-[15px] font-semibold text-gold-light transition-colors hover:text-[#F8F3E9]">
            Learn More <span class="text-[17px]">→</span>
          </a>
        </div>
        <!-- Personal Shopping -->
        <div class="flex flex-col gap-5 rounded-xl bg-olive p-9 shadow-[0_8px_28px_rgba(67,80,58,0.18)] md:p-11 reveal">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <circle cx="24" cy="24" r="16" stroke="#D6B676" stroke-width="2"></circle>
            <ellipse cx="24" cy="24" rx="7" ry="16" stroke="#D6B676" stroke-width="2"></ellipse>
            <path d="M8 24 H40" stroke="#D6B676" stroke-width="2"></path>
          </svg>
          <h3 class="m-0 font-serif text-[24px] font-bold leading-tight text-[#F5F3EA] md:text-[27px]">Global Personal Shopping</h3>
          <p class="m-0 text-[16px] leading-relaxed text-[#C9CDBB]">
            We order products from Amazon, Daraz &amp; more on your behalf — purchased, consolidated, and delivered to your door with transparent, itemized pricing.
          </p>
          <a href="/services" class="mt-1 flex items-center gap-2 text-[15px] font-semibold text-gold-light transition-colors hover:text-[#F5F3EA]">
            Learn More <span class="text-[17px]">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHY AMANAT ============ -->
  <section class="border-t border-line bg-cream">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-11 px-5 py-20 md:px-10 md:py-[88px]">
      <Eyebrow text="Why Amanat" class="reveal" />
      <div class="grid grid-cols-1 gap-7 md:grid-cols-3">
        {
          [
            { t: 'Authentic Afghan origin', d: "Sourced directly from Kandahar's orchards and growers — provenance you can document." },
            { t: 'Secure end-to-end shipping', d: 'Careful packing, customs handling, and tracked freight from our facility to your port.' },
            { t: 'Reliable partnership', d: 'A single accountable partner for officials, importers, and institutional buyers.' },
          ].map((c) => (
            <div class="flex flex-col gap-3 rounded-[10px] border border-line bg-paper p-8 reveal">
              <div class="mb-1 h-3 w-3 rotate-45 bg-accent"></div>
              <span class="font-serif text-[20px] font-bold leading-snug text-plum">{c.t}</span>
              <span class="text-[15px] leading-relaxed text-muted">{c.d}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ ROUTES PREVIEW ============ -->
  <section class="bg-ink">
    <div class="mx-auto grid max-w-[1240px] grid-cols-1 items-center gap-12 px-5 py-20 md:grid-cols-[0.9fr_1.1fr] md:gap-[72px] md:px-10 md:py-24">
      <div class="flex flex-col gap-[22px]">
        <Eyebrow text="Routes & Coverage" tone="dark" />
        <h2 class="m-0 font-serif text-[28px] font-bold leading-tight text-[#F8F3E9] md:text-[36px]" style="text-wrap:pretty;">
          We currently ship to India, Canada, UK &amp; USA — with more destinations coming.
        </h2>
        <div class="mt-1 flex flex-wrap gap-3">
          {['India', 'Canada', 'United Kingdom', 'United States'].map((c) => (
            <span class="rounded-full border border-[#5A5147] px-5 py-2 text-[14px] font-semibold text-[#EDE4D4]">{c}</span>
          ))}
          <span class="rounded-full border border-dashed border-label px-5 py-2 text-[14px] font-semibold text-[#B8A57E]">More coming</span>
        </div>
        <a href="/contact" class="mt-2 flex items-center gap-2 self-start text-[15px] font-semibold text-gold-light transition-colors hover:text-[#F8F3E9]">
          Ask about your destination <span class="text-[17px]">→</span>
        </a>
      </div>
      <ImageFrame
        src="/images/routes-worldmap.svg"
        alt="World map showing export routes from Kandahar to India, Canada, UK and USA"
        tone="dark"
        class="h-[300px] rounded-[10px] md:h-[400px]"
        label="GRAPHIC: world map with route lines<br>from Kandahar to India, Canada, UK, USA"
      />
    </div>
  </section>
</BaseLayout>

---
/**
 * Shell for the signed-in tracker admin pages (top bar + centred content).
 * The login screen renders without it — see tracking/admin/index.astro.
 */
import '../styles/tracker-admin.css';
import { SITE } from '../consts';

interface Props {
  title: string;
  /** Line under the brand. Defaults to the shipment tracker's. */
  subtitle?: string;
  /** Where the brand links to. */
  home?: string;
  /** The "view" link on the right: its label and target. */
  viewLabel?: string;
  viewHref?: string;
  /** Which session the Log out button ends — each panel has its own. */
  logoutAction?: string;
}
const {
  title,
  subtitle = 'Shipment Tracker Admin',
  home = '/tracking/admin',
  viewLabel = 'View tracking page',
  viewHref = '/tracking/shipment',
  logoutAction = '/api/tracker/logout',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — {subtitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <a href={home} class="brand" style="color:inherit;text-decoration:none;">
        <b>{SITE.name}</b>
        <small>{subtitle}</small>
      </a>
      <div class="actions">
        <a class="view" href={viewHref} target="_blank" rel="noopener">{viewLabel}</a>
        <!-- POST, so a logout can't be triggered by a stray link or prefetch.
             Each panel logs out of its OWN session — the website admin, the
             tracker and the orders panel keep separate cookies. -->
        <form method="post" action={logoutAction}>
          <button class="logout" type="submit">Log out</button>
        </form>
      </div>
    </header>

    <div class="wrap">
      <slot />
    </div>
  </body>
</html>

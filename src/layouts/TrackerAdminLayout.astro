---
/**
 * Shell for the signed-in tracker admin pages (top bar + centred content).
 * The login screen renders without it — see tracking/admin/index.astro.
 */
import '../styles/tracker-admin.css';
import { SITE } from '../consts';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Tracker Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <a href="/tracking/admin" class="brand" style="color:inherit;text-decoration:none;">
        <b>{SITE.name}</b>
        <small>Shipment Tracker Admin</small>
      </a>
      <div class="actions">
        <a class="view" href="/tracking" target="_blank" rel="noopener">View tracking page</a>
        <!-- POST, so a logout can't be triggered by a stray link or prefetch. -->
        <form method="post" action="/api/tracker/logout">
          <button class="logout" type="submit">Log out</button>
        </form>
      </div>
    </header>

    <div class="wrap">
      <slot />
    </div>
  </body>
</html>

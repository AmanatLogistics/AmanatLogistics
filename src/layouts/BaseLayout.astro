---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  /** Active nav item href, e.g. "/about" */
  active?: string;
}

const { title, description = SITE.description, active } = Astro.props;
const fullTitle = `${SITE.name} — ${title}`;
const canonical = new URL(Astro.url.pathname, SITE.domain).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.domain}/images/og-image.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts (matches approved design) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Archivo:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Organization structured data (SEO) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: SITE.name,
        description: SITE.description,
        url: SITE.domain,
        email: 'info@amanatlogistics.com',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Kandahar',
          addressCountry: 'AF',
        },
      })}
    />
  </head>
  <body>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Subtle, accessible scroll-reveal -->
    <script>
      const els = document.querySelectorAll('.reveal');
      if (els.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE } from '../consts';
import { getContent } from '../lib/store';

interface Props {
  title: string;
  description?: string;
  /** Active nav item href, e.g. "/about" */
  active?: string;
}

const { seo } = await getContent();
const { title, description = seo.description, active } = Astro.props;
const fullTitle = `${SITE.name} — ${title}`;
const canonical = new URL(Astro.url.pathname, SITE.domain).href;
const ogImage = new URL(seo.ogImage, SITE.domain).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts (matches approved design) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Archivo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Organization structured data (SEO) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: SITE.name,
        description: SITE.description,
        url: SITE.domain,
        email: 'info@amanatlogistics.com',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Kandahar',
          addressCountry: 'AF',
        },
      })}
    />

    <!-- Per-page additions to <head> (the tracking page uses this to load an
         Arabic-script font only when it is showing Pashto). -->
    <slot name="head" />

    <!-- App-like navigation: swap pages without a full reload -->
    <ClientRouter />
  </head>
  <body>
    <div id="nav-progress" aria-hidden="true"></div>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <!-- Subtle, accessible scroll-reveal — re-runs after each in-app navigation -->
    <script>
      function initReveal() {
        const els = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);

      // Slim top progress bar during page navigation (view transitions)
      const bar = document.getElementById('nav-progress');
      let trickle: ReturnType<typeof setInterval> | undefined;
      document.addEventListener('astro:before-preparation', () => {
        if (!bar) return;
        clearInterval(trickle);
        bar.classList.add('loading');
        bar.style.width = '25%';
        let w = 25;
        trickle = setInterval(() => {
          w = Math.min(w + Math.random() * 12, 88);
          bar.style.width = `${w}%`;
        }, 220);
      });
      document.addEventListener('astro:page-load', () => {
        if (!bar) return;
        clearInterval(trickle);
        bar.style.width = '100%';
        setTimeout(() => {
          bar.classList.remove('loading');
          bar.style.width = '0';
        }, 350);
      });
    </script>
  </body>
</html>

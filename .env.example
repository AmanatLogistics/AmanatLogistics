# ─── Copy this file to ".env" and fill in real values. Never commit ".env". ───

# Resend API key (get it free at https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address shown on emails the site sends.
# BEFORE your domain is verified in Resend, leave this commented out — the code
# falls back to Resend's sandbox sender for testing.
# AFTER you verify amanatlogistics.com in Resend, set this to your domain:
# MAIL_FROM=Amanat Logistics <noreply@amanatlogistics.com>

# Where quote requests are delivered (defaults to info@amanatlogistics.com):
# MAIL_TO=info@amanatlogistics.com

# ─── Admin panel (yoursite.com/admin) ───
# Choose a strong password — this is the only key to your admin panel.
# In local dev, if unset, the password is "admin123".
ADMIN_PASSWORD=choose-a-strong-password

# ─── Shipment tracker ───
# The tracker has its OWN admin panel at yoursite.com/tracking/admin, separate
# from the website content admin above. Give it a different password — that way
# whoever updates shipments cannot also edit the website, and vice versa.
# In local dev, if unset, the password is "tracker123".
TRACKER_ADMIN_PASSWORD=choose-a-different-strong-password

# Shipment data lives in Postgres (NOT Vercel Blob). On Vercel: Storage →
# Create Database → Neon → connect it to this project, and DATABASE_URL is set
# for you automatically — Neon's free plan is enough for this. The tracker
# creates its own tables on first use, so there is no SQL to import.
# For local dev, paste a connection string from the Neon dashboard:
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Image/content storage in production is Vercel Blob. On Vercel: Storage →
# Create Blob store → connect to this project. BLOB_READ_WRITE_TOKEN is then
# set automatically — you never need to fill it in here for local dev
# (locally, edits save to .data/ and public/uploads/ instead).
